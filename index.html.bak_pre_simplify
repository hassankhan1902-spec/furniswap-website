    'storage-4': { name: '4-Door Master Wardrobe Unit', base: 110000, room: 'storage' },
    'credenza': { name: 'Console / TV Credenza Unit', base: 48000, room: 'living' },
    'other': { name: 'Other Custom Furniture Piece', base: 50000, room: 'other' }
  },

  conditionRates: {
    'like-new': { min: 0.42, max: 0.52, label: 'Like New (Barely used, mint condition)', recovery: '45%' },
    'good': { min: 0.30, max: 0.40, label: 'Good (Minor wear, solid structure)', recovery: '35%' },
    'fair': { min: 0.18, max: 0.28, label: 'Fair (Noticeable scratches/wear, fully usable)', recovery: '23%' },
    'poor': { min: 0.08, max: 0.16, label: 'Heavily Worn (Torn fabric/needs restoration)', recovery: '12%' }
  },

  ageFactors: {
    'under-1': 1.05,
    '1-3': 1.0,
    '3-5': 0.88,
    '5-10': 0.72,
    '10-plus': 0.58
  },

  materialFactors: {
    'sheesham': 1.15,
    'acacia': 1.10,
    'teak-oak': 1.18,
    'hardwood': 1.0,
    'mdf-chipboard': 0.85,
    'mixed-other': 0.95
  },

  calculate(typeKey, conditionKey, ageKey, materialKey) {
    const bench = this.benchmarks[typeKey] || this.benchmarks['sofa-5'];
    const cond = this.conditionRates[conditionKey] || this.conditionRates['good'];
    const ageFac = this.ageFactors[ageKey] || 1.0;
    const matFac = this.materialFactors[materialKey] || 1.0;

    const baseVal = bench.base * ageFac * matFac;
    let minCredit = Math.round((baseVal * cond.min) / 500) * 500;
    let maxCredit = Math.round((baseVal * cond.max) / 500) * 500;

    if (minCredit < 4000) minCredit = 4000;
    if (maxCredit < minCredit + 2000) maxCredit = minCredit + 3000;

    return {
      furnitureTypeKey: typeKey,
      furnitureName: bench.name,
      baseBenchmark: bench.base,
      conditionKey,
      conditionLabel: cond.label,
      recoveryRate: cond.recovery,
      ageKey,
      materialKey,
      minCredit,
      maxCredit,
      avgCredit: Math.round((minCredit + maxCredit) / 2)
    };
  }
};

