      border-radius: 8px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 220px;
    }

    /* 5-Step Request Tracker Timeline */
    .tracker-timeline {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      margin: 24px 0 12px;
      position: relative;
    }
    .tracker-step {
      text-align: center;
      position: relative;
    }
    .tracker-step-circle {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #E5E7EB;
      color: #9CA3AF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      margin: 0 auto 8px;
      position: relative;
      z-index: 2;
      transition: all 0.3s;
    }
    .tracker-step.completed .tracker-step-circle {
      background: var(--sage);
      color: #FFFFFF;
    }
    .tracker-step.active .tracker-step-circle {
      background: var(--terracotta);
      color: #FFFFFF;
      box-shadow: 0 0 0 4px var(--terracotta-soft);
    }
    .tracker-step-title {
      font-size: 11px;
      font-weight: 600;
      color: var(--charcoal);
      line-height: 1.3;
    }

    /* Lightbox Modal */
    .lightbox-dialog {
      max-width: 90vw;
      max-height: 90vh;
      background: transparent;
      box-shadow: none;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .lightbox-img {
      max-width: 85vw;
      max-height: 85vh;
      border-radius: 8px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    }

    /* Responsive adjustments */
    @media (max-width: 991px) {
      .val-studio-grid,
      .calc-layout-grid,
      .customizer-body {
        grid-template-columns: 1fr;
      }
      .val-result-box, .calc-receipt-box {
        position: static;
      }
      .dash-stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .sub-card {
        grid-template-columns: 1fr;
      }
      .sub-thumb {
        width: 100%;
        height: 180px;
      }
      .tracker-timeline {
        grid-template-columns: 1fr;
        gap: 16px;
        text-align: left;
      }
      .tracker-step {
        display: flex;
        align-items: center;
        gap: 12px;
        text-align: left;
      }
      .tracker-step-circle {
        margin: 0;
      }
    }
    @media (max-width: 640px) {
      .form-row, .form-row-3 {
        grid-template-columns: 1fr;
      }
      .condition-chips-grid {
        grid-template-columns: 1fr;
      }
      .val-price-range {
        font-size: 28px;
      }
      .receipt-total-amount {
        font-size: 28px;
      }
    }

  </style>
</head>
