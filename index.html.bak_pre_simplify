    function initTransformationPlayer() {
      const stage = document.getElementById('transStage');
      if (!stage) return;

      // Auto-detect HTML5 video if transformation.mp4 is provided in resources
      const videoEl = document.getElementById('heroTransformVideo');
      if (videoEl) {
        videoEl.addEventListener('canplay', () => {
          videoEl.style.display = 'block';
          videoEl.play().catch(() => {});
        });
      }

      function handleDragMove(clientX) {
        if (clientX === undefined) return;
        const rect = stage.getBoundingClientRect();
        const offsetX = clientX - rect.left;
        const percent = (offsetX / rect.width) * 100;
        setTransformationSplit(percent);
      }

      function onMouseDown(e) {
        isTransDragging = true;
        stage.classList.add('is-dragging');
        if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
        handleDragMove(e.clientX);
      }

      function onMouseMove(e) {
        if (!isTransDragging) return;
        handleDragMove(e.clientX);
      }

      function onMouseUp() {
        if (!isTransDragging) return;
        isTransDragging = false;
        stage.classList.remove('is-dragging');
        if (isTransAutoPlaying) {
          if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
          transIdleResumeTimer = setTimeout(() => {
            const currentRatio = Math.max(-1, Math.min(1, (transSplitPos - 50) / 28));
            transAnimStartTime = performance.now() - (Math.asin(currentRatio) / 1.05) * 1000;
          }, 3500);
        }
      }

      let touchStartX = null;
      let touchStartY = null;
      let touchIsScrolling = null;

      function onTouchStart(e) {
        if (!e.touches || !e.touches[0]) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchIsScrolling = null;
        isTransDragging = true;
        stage.classList.add('is-dragging');
        if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
      }

      function onTouchMove(e) {
        if (!isTransDragging || !e.touches || !e.touches[0]) return;
        const currentX = e.touches[0].clientX;
        const currentY = e.touches[0].clientY;
        const deltaX = Math.abs(currentX - touchStartX);
        const deltaY = Math.abs(currentY - touchStartY);

        if (touchIsScrolling === null && (deltaX > 6 || deltaY > 6)) {
          if (deltaY > deltaX) {
            touchIsScrolling = true;
            isTransDragging = false;
            stage.classList.remove('is-dragging');
            return;
          } else {
            touchIsScrolling = false;
          }
        }

        if (touchIsScrolling === false) {
          handleDragMove(currentX);
        }
      }

      function onTouchEnd() {
        if (isTransDragging) {
          isTransDragging = false;
          stage.classList.remove('is-dragging');
          if (isTransAutoPlaying) {
            if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
            transIdleResumeTimer = setTimeout(() => {
              const currentRatio = Math.max(-1, Math.min(1, (transSplitPos - 50) / 28));
              transAnimStartTime = performance.now() - (Math.asin(currentRatio) / 1.05) * 1000;
            }, 3500);
          }
        }
        touchStartX = null;
        touchStartY = null;
        touchIsScrolling = null;
      }

      stage.addEventListener('mousedown', onMouseDown);
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);

      stage.addEventListener('touchstart', onTouchStart, { passive: true });
      window.addEventListener('touchmove', onTouchMove, { passive: true });
      window.addEventListener('touchend', onTouchEnd, { passive: true });

      // Keyboard Accessibility for Slider
      const divider = document.getElementById('transDivider');
      if (divider) {
        divider.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
            e.preventDefault();
            setTransformationSplit(transSplitPos - 5);
          } else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
            e.preventDefault();
            setTransformationSplit(transSplitPos + 5);
          }
        });
      }

      setTransformationSplit(50);
      transAnimFrame = requestAnimationFrame(transAutoSweepLoop);
    }

