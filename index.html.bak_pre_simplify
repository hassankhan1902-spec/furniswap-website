    if (selectedOldPhotos.length >= 5) {
      alert(currentLang === 'ur' ? 'آپ زیادہ سے زیادہ 5 تصاویر اپ لوڈ کر سکتے ہیں۔' : 'You can upload up to 5 photos.');
      break;
    }
    const file = files[i];
    if (!file.type.startsWith('image/')) continue;

    const reader = new FileReader();
    reader.onload = (event) => {
      // Compress image client-side to prevent memory bloat
      compressImage(event.target.result, 1000, 0.8, (compressedDataUrl) => {
        selectedOldPhotos.push(compressedDataUrl);
        renderPhotoPreviews();
      });
    };
    reader.readAsDataURL(file);
  }
  e.target.value = '';
}

function compressImage(dataUrl, maxDim, quality, callback) {
  const img = new Image();
  img.onload = () => {
    let width = img.width;
    let height = img.height;

    if (width > height) {
      if (width > maxDim) {
        height = Math.round((height * maxDim) / width);
        width = maxDim;
      }
    } else {
      if (height > maxDim) {
        width = Math.round((width * maxDim) / height);
        height = maxDim;
      }
    }

    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, width, height);
    callback(canvas.toDataURL('image/jpeg', quality));
  };
  img.src = dataUrl;
}

