async function saveAdminSubmissionChanges(id) {
  const item = adminSubmissionsCache.find(s => s.id === id);
  if (!item) return;

  const creditInput = document.getElementById('approvedCredit_' + id);
  const statusSelect = document.getElementById('adminStatus_' + id);
  const notesInput = document.getElementById('adminNotes_' + id);

  item.approvedCredit = creditInput ? parseInt(creditInput.value) || 0 : item.approvedCredit;
  item.status = statusSelect ? statusSelect.value : 'pending';
  item.adminNotes = notesInput ? notesInput.value.trim() : '';

  await FurniDB.save('submissions', item);
  alert(`Submission ${id} updated successfully!`);
  refreshAdminDashboard();
}

function notifyCustomerOnWhatsApp(id) {
  const item = adminSubmissionsCache.find(s => s.id === id);
  if (!item || !item.customerPhone) {
    alert('Customer phone number not available.');
    return;
  }

  let cleanPhone = item.customerPhone.replace(/\D/g, '');
  if (cleanPhone.startsWith('0')) cleanPhone = '92' + cleanPhone.slice(1);
  if (!cleanPhone.startsWith('92')) cleanPhone = '92' + cleanPhone;

  const credit = item.approvedCredit || item.estimatedCreditAvg || 30000;
  const msg = `Hi ${item.customerName || 'there'}! This is FurniSwap team.
We have reviewed your furniture submission (${item.furnitureType}).
Your approved swap credit is Rs. ${credit.toLocaleString()}!
Let us know when we can schedule the pickup and delivery of your brand new custom furniture.`;

  window.open(`https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`, '_blank');
}

async function deleteAdminSubmission(id) {
  if (!confirm(`Are you sure you want to delete submission ${id}?`)) return;
  await FurniDB.delete('submissions', id);
  refreshAdminDashboard();
}

