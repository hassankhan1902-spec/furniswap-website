      background: var(--cream-50);
    }
    .cat-filter-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 36px;
      flex-wrap: wrap;
    }
    .cat-pills-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .cat-filter-btn {
      background: #FFFFFF;
      border: 1px solid var(--border-light);
      padding: 8px 18px;
      border-radius: var(--radius-full);
      font-size: 13px;
      font-weight: 500;
      color: var(--slate-700);
      cursor: pointer;
      transition: all 0.2s;
    }
    .cat-filter-btn:hover {
      border-color: var(--coral);
      color: var(--coral);
    }
    .cat-filter-btn.active {
      background: var(--slate-900);
      border-color: var(--slate-900);
      color: #FFFFFF;
    }

    .cat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }
    .cat-item-card {
      background: #FFFFFF;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
    }
    .cat-item-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-focus);
    }
    .cat-card-preview {
      background: #FAF8F5;
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid var(--border-light);
      overflow: hidden;
      position: relative;
    }
    .cat-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cat-item-card:hover .cat-card-img {
      transform: scale(1.05);
    }
    .cat-card-body {
      padding: 22px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .cat-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }
    .cat-tier-badge {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .cat-room-tag {
      font-size: 11px;
      color: var(--slate-400);
    }
    .cat-card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--slate-900);
      margin-bottom: 6px;
    }
    .cat-card-desc {
      font-size: 12.5px;
      color: var(--slate-600);
      line-height: 1.5;
      margin-bottom: 16px;
      flex-grow: 1;
    }
    .cat-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      border-top: 1px solid var(--border-light);
    }
    .cat-price-val {
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 700;
      color: var(--slate-900);
    }
    .cat-btn-enquire {
      background: var(--coral-soft);
      color: var(--coral);
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      transition: all 0.2s;
    }
    .cat-btn-enquire:hover {
      background: var(--coral);
      color: #FFFFFF;
    }

    /* -------------------------------------------------------------
       DESIGN FREEDOM SHOWCASE (BRAND KIT PAGE 6)
       ------------------------------------------------------------- */
    .design-freedom-banner {
      background: #FFFFFF;
      border: 1.5px solid var(--beige-border);
      border-radius: var(--radius-lg);
      padding: 38px 42px;
      margin-top: 48px;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
    }
    .design-freedom-banner::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 340px;
      height: 100%;
      background: radial-gradient(circle at 100% 50%, var(--terracotta-soft) 0%, transparent 70%);
      pointer-events: none;
    }
    .design-freedom-layout {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 36px;
      align-items: center;
      position: relative;
      z-index: 1;
    }
    .freedom-title {
      font-family: var(--font-heading);
      font-size: clamp(26px, 2.6vw, 34px);
      font-weight: 700;
      color: var(--charcoal);
      line-height: 1.2;
      margin-bottom: 12px;
    }
    .freedom-title em {
      font-style: italic;
      color: var(--terracotta);
    }
    .freedom-desc {
      font-size: 14.5px;
      color: var(--charcoal-600);
      line-height: 1.6;
      margin-bottom: 22px;
    }
    .materials-swatches-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }
    .swatch-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      background: var(--warm-cream-alt);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      transition: all 0.2s ease;
    }
    .swatch-card:hover {
      border-color: var(--terracotta-border);
      transform: translateY(-2px);
    }
    .swatch-disc {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      flex-shrink: 0;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    }
    .swatch-title {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--charcoal);
      line-height: 1.2;
    }
    .swatch-note {
      font-size: 11px;
      color: var(--charcoal-muted);
    }
    .freedom-prompt-box {
      background: var(--warm-cream);
      border: 1.5px dashed var(--terracotta-border);
      border-radius: var(--radius-md);
      padding: 26px 28px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .prompt-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--terracotta);
    }
    .prompt-heading {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      color: var(--charcoal);
      line-height: 1.25;
    }
    .prompt-quote {
      font-size: 13.5px;
      color: var(--charcoal-700);
      font-style: italic;
      line-height: 1.5;
    }
    @media (max-width: 900px) {
      .design-freedom-layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }
      .design-freedom-banner {
        padding: 28px 20px;
      }
      .materials-swatches-grid {
        grid-template-columns: 1fr;
      }
    }

    /* -------------------------------------------------------------
       CUSTOM QUOTATION SUMMARY CARD (BRAND KIT PAGE 9 & 10)
       ------------------------------------------------------------- */
    .quotation-summary-card {
      background: var(--warm-cream-alt);
      border: 1.5px solid var(--beige-border);
      border-radius: var(--radius-sm);
      padding: 16px 18px;
      margin-top: 18px;
      text-align: left;
    }
    .qsc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-light);
    }
    .qsc-tag {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--terracotta);
    }
    .qsc-brand {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--charcoal-muted);
    }
    .qsc-item-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      margin-bottom: 4px;
    }
    .qsc-label {
      color: var(--charcoal-muted);
    }
    .qsc-val {
      font-weight: 600;
      color: var(--charcoal);
      text-align: right;
    }
    .qsc-divider {
      height: 1px;
      background: var(--border-light);
      margin: 8px 0;
    }
    .qsc-math-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--charcoal-700);
      margin-bottom: 4px;
    }
    .qsc-math-val {
      font-weight: 600;
    }
    .qsc-total-row {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      font-weight: 700;
      color: var(--charcoal);
      padding-top: 6px;
      border-top: 1px dashed var(--beige-border);
      margin-top: 6px;
    }
    .qsc-footer-note {
      font-size: 11px;
      color: var(--sage);
      font-weight: 600;
      margin-top: 8px;
      text-align: center;
    }

    html[lang="ur"] .design-freedom-layout {
      direction: rtl;
    }
    html[lang="ur"] .freedom-prompt-box {
      text-align: right;
    }
    html[lang="ur"] .swatch-card {
      direction: rtl;
      text-align: right;
    }
    html[lang="ur"] .quotation-summary-card {
      direction: rtl;
      text-align: right;
    }
    html[lang="ur"] .qsc-val {
      text-align: left;
    }

    /* -------------------------------------------------------------
       ARTISAN WORKSHOP & CRAFTSMANSHIP VIDEO SECTION
       ------------------------------------------------------------- */
    .artisan-section {
      background: #14181C;
      color: #FFFFFF;
      position: relative;
      overflow: hidden;
    }
    .artisan-section::before {
      content: '';
      position: absolute;
      top: -120px;
      right: -120px;
      width: 480px;
      height: 480px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(196, 92, 42, 0.16) 0%, transparent 70%);
      pointer-events: none;
    }
    .artisan-section::after {
      content: '';
      position: absolute;
      bottom: -100px;
      left: -100px;
      width: 440px;
      height: 440px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(74, 103, 65, 0.14) 0%, transparent 70%);
      pointer-events: none;
    }
    .artisan-section .section-header {
      margin-bottom: 48px;
    }
    .artisan-section .section-tag {
      color: var(--terracotta);
    }
    .artisan-section .section-title {
      color: #FFFFFF;
    }
    .artisan-section .section-title em {
      color: var(--terracotta);
    }
    .artisan-section .section-desc {
      color: rgba(255, 255, 255, 0.78);
    }
    .artisan-layout {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 36px;
      align-items: stretch;
      margin-bottom: 48px;
    }
    .artisan-video-frame {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: #000000;
      box-shadow: 0 24px 60px -10px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.12);
      aspect-ratio: 16 / 9;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .artisan-video-player {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .artisan-video-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(10, 12, 14, 0.25) 0%, rgba(10, 12, 14, 0.7) 100%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 24px;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
    .artisan-video-frame.is-playing:not(:hover) .artisan-video-overlay {
      opacity: 0;
    }
    .artisan-video-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: rgba(20, 24, 28, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #FFFFFF;
      font-size: 11px;
      font-weight: 700;
      padding: 5px 13px;
      border-radius: var(--radius-full);
      border: 1px solid rgba(255, 255, 255, 0.2);
      align-self: flex-start;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      pointer-events: auto;
    }
    .artisan-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #25D366;
      box-shadow: 0 0 8px #25D366;
    }
    .artisan-play-center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: auto;
      text-align: center;
    }
    .artisan-play-btn {
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background: var(--terracotta);
      color: #FFFFFF;
      border: 3.5px solid rgba(255, 255, 255, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 10px;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(196, 92, 42, 0.6), 0 0 0 6px rgba(196, 92, 42, 0.28);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .artisan-play-btn:hover {
      transform: scale(1.1);
      background: var(--terracotta-hover);
      box-shadow: 0 14px 40px rgba(196, 92, 42, 0.75), 0 0 0 9px rgba(196, 92, 42, 0.38);
    }
    .artisan-play-btn svg {
      width: 28px;
      height: 28px;
      margin-left: 3px;
    }
    .artisan-play-caption {
      font-size: 12px;
      font-weight: 700;
      color: #FFFFFF;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85);
      letter-spacing: 0.5px;
    }
    .artisan-video-bottom-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      pointer-events: auto;
      width: 100%;
    }
    .artisan-time-indicator {
      font-size: 11px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.9);
      letter-spacing: 0.4px;
      background: rgba(0, 0, 0, 0.6);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .artisan-video-actions {
      display: flex;
      gap: 8px;
    }
    .artisan-action-btn {
      background: rgba(26, 26, 26, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #FFFFFF;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .artisan-action-btn:hover {
      background: var(--terracotta);
      border-color: var(--terracotta);
      transform: scale(1.08);
    }

    /* Side Craft Story Cards */
    .artisan-story-wrap {
      display: flex;
      flex-direction: column;
      gap: 12px;
      justify-content: center;
    }
    .artisan-story-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-md);
      padding: 16px 18px;
      display: flex;
      gap: 14px;
      align-items: flex-start;
      transition: all 0.25s ease;
      cursor: pointer;
    }
    .artisan-story-card:hover,
    .artisan-story-card.active {
      background: rgba(255, 255, 255, 0.09);
      border-color: var(--terracotta-border);
      transform: translateX(4px);
    }
    .artisan-story-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: rgba(196, 92, 42, 0.16);
      color: var(--terracotta);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .artisan-story-title {
      font-size: 14.5px;
      font-weight: 700;
      color: #FFFFFF;
      margin-bottom: 4px;
    }
    .artisan-story-desc {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.72);
      line-height: 1.5;
    }

    /* Workshop Metrics Bar */
    .artisan-metrics-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      padding: 24px 28px;
      text-align: center;
    }
    .artisan-metric-item {
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0 12px;
    }
    .artisan-metric-item:last-child {
      border-right: none;
    }
    .artisan-metric-num {
      font-family: var(--font-heading);
      font-size: clamp(28px, 3.2vw, 36px);
      font-weight: 700;
      color: var(--terracotta);
      line-height: 1;
      margin-bottom: 4px;
    }
    .artisan-metric-label {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.72);
      letter-spacing: 0.3px;
    }

    @media (max-width: 991px) {
      .artisan-layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }
      .artisan-metrics-strip {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
      .artisan-metric-item:nth-child(2) {
        border-right: none;
      }
    }
    @media (max-width: 640px) {
      .artisan-metrics-strip {
        grid-template-columns: 1fr 1fr;
        padding: 16px 12px;
        gap: 16px;
      }
      .artisan-video-overlay {
        padding: 14px;
      }
      .artisan-play-btn {
        width: 60px;
        height: 60px;
      }
      .artisan-play-btn svg {
        width: 22px;
        height: 22px;
      }
      .artisan-story-card {
        padding: 14px 14px;
      }
    }

    /* -------------------------------------------------------------
       COMPARISON TABLE (FURNISWAP VS OLX VS MARKET)
       ------------------------------------------------------------- */
    .compare-section {
      background: #FFFFFF;
    }
    .compare-table-wrapper {
      background: #FFFFFF;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      overflow-x: auto;
      box-shadow: var(--shadow-sm);
    }
    .compare-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      min-width: 640px;
    }
    .compare-table th {
      background: var(--cream-100);
      padding: 18px 24px;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--slate-800);
      border-bottom: 1px solid var(--border-light);
    }
    .compare-table th.furniswap-col {
      background: var(--slate-900);
      color: #FFFFFF;
    }
    .compare-table td {
      padding: 18px 24px;
      font-size: 13.5px;
      border-bottom: 1px solid var(--border-light);
      color: var(--slate-700);
    }
    .compare-table td.furniswap-cell {
      background: rgba(232, 96, 74, 0.03);
      font-weight: 600;
      color: var(--slate-900);
      border-left: 2px solid var(--coral);
      border-right: 1px solid var(--coral-border);
    }

    /* Fleet & Studio Visual Showcase */
    .fleet-studio-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      margin-top: 40px;
    }
    .fs-card {
      background: #FFFFFF;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .fs-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-focus);
    }
    .fs-card-media {
      position: relative;
      height: 200px;
      overflow: hidden;
      background: var(--warm-cream);
    }
    .fs-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.5s ease;
    }
    .fs-card:hover .fs-img {
      transform: scale(1.04);
    }
    .fs-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(26, 26, 26, 0.82);
      backdrop-filter: blur(6px);
      color: #FFFFFF;
      font-size: 11px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: var(--radius-full);
      letter-spacing: 0.3px;
    }
    .fs-card-body {
      padding: 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .fs-title {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      color: var(--charcoal);
      margin-bottom: 8px;
      line-height: 1.25;
    }
    .fs-desc {
      font-size: 13.5px;
      color: var(--charcoal-muted);
      line-height: 1.6;
      margin-bottom: 16px;
      flex-grow: 1;
    }
    .fs-perk {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--terracotta);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* -------------------------------------------------------------
       CUSTOMER REVIEWS
       ------------------------------------------------------------- */
    .reviews-section {
      background: var(--cream-100);
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .review-card {
      background: #FFFFFF;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      padding: 32px 28px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .review-stars {
      color: var(--gold);
      font-size: 16px;
      margin-bottom: 14px;
    }
    .review-quote {
      font-family: var(--font-heading);
      font-size: 18px;
      line-height: 1.55;
      color: var(--slate-800);
      font-style: italic;
      margin-bottom: 24px;
    }
    .reviewer-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-top: 16px;
      border-top: 1px solid var(--border-light);
    }
    .reviewer-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--coral), var(--gold));
      color: #FFFFFF;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
    }
    .reviewer-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--slate-900);
    }
    .reviewer-loc {
      font-size: 12px;
      color: var(--slate-400);
    }

    /* -------------------------------------------------------------
       FAQ ACCORDION
       ------------------------------------------------------------- */
    .faq-section {
      background: #FFFFFF;
    }
    .faq-layout {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 56px;
      align-items: start;
    }
    .faq-help-card {
      background: var(--cream-100);
      border-radius: var(--radius-md);
      padding: 32px;
      border: 1px solid var(--border-light);
    }
    .faq-help-card h3 {
      font-size: 18px;
      font-weight: 700;
      color: var(--slate-900);
      margin-bottom: 8px;
    }
    .faq-help-card p {
      font-size: 13.5px;
      color: var(--slate-600);
      margin-bottom: 20px;
      line-height: 1.5;
    }

    .faq-accordion {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .faq-item {
      background: #FFFFFF;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .faq-item.open {
      border-color: var(--coral-border);
      box-shadow: var(--shadow-sm);
    }
    .faq-question-btn {
      width: 100%;
      background: transparent;
      border: none;
      padding: 20px 24px;
      text-align: left;
      font-size: 15px;
      font-weight: 600;
      color: var(--slate-900);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .faq-toggle-icon {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--cream-100);
      color: var(--slate-600);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }
    .faq-item.open .faq-toggle-icon {
      background: var(--coral);
      color: #FFFFFF;
      transform: rotate(45deg);
    }
    .faq-answer-panel {
      padding: 0 24px 20px;
      font-size: 14px;
      color: var(--slate-600);
      line-height: 1.65;
      display: none;
    }
    .faq-item.open .faq-answer-panel {
      display: block;
    }

    /* -------------------------------------------------------------
       CALL TO ACTION BANNER
       ------------------------------------------------------------- */
    .cta-banner-section {
      background: var(--slate-900);
      color: #FFFFFF;
      position: relative;
      overflow: hidden;
      padding: 80px 0;
    }
    .cta-banner-inner {
      text-align: center;
      max-width: 680px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }
    .cta-banner-inner h2 {
      font-family: var(--font-heading);
      font-size: clamp(38px, 4.5vw, 56px);
      font-weight: 700;
      color: #FFFFFF;
      line-height: 1.15;
      margin-bottom: 18px;
    }
    .cta-banner-inner p {
      font-size: 16px;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 36px;
      line-height: 1.6;
    }
    .cta-btn-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    /* -------------------------------------------------------------
       FOOTER
       ------------------------------------------------------------- */
    footer {
      background: var(--charcoal);
      color: rgba(255, 255, 255, 0.7);
      padding: 68px 0 32px;
      font-size: 13.5px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 56px;
    }
    .footer-brand-title {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 700;
      color: #FFFFFF;
      margin-bottom: 2px;
      display: flex;
      align-items: center;
      gap: 12px;
      line-height: 1;
    }
    .footer-brand-title span {
      color: var(--terracotta);
    }
    .footer-brand-tagline {
      font-family: var(--font-body);
      font-size: 8px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--beige);
      margin-bottom: 16px;
      display: block;
    }
    .footer-bio {
      line-height: 1.6;
      margin-bottom: 20px;
      max-width: 300px;
    }
    .footer-wa-callout {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.06);
      padding: 8px 14px;
      border-radius: var(--radius-sm);
      color: #FFFFFF;
      font-weight: 600;
    }

    .footer-col-title {
      font-size: 13px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }
    .footer-nav-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .footer-nav-list a {
      transition: color 0.2s;
    }
    .footer-nav-list a:hover {
      color: var(--coral);
    }

    .footer-bottom-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 32px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 12.5px;
      flex-wrap: wrap;
      gap: 16px;
    }

    /* -------------------------------------------------------------
       FLOATING WHATSAPP & MODAL
       ------------------------------------------------------------- */
    .floating-wa-btn {
      position: fixed;
      bottom: 28px;
      bottom: max(24px, env(safe-area-inset-bottom, 24px));
      right: 28px;
      right: max(20px, env(safe-area-inset-right, 20px));
      z-index: 999;
      background: #25D366;
      color: #FFFFFF;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
      transition: all 0.3s ease;
      cursor: pointer;
      border: none;
    }
    .floating-wa-btn:hover {
      transform: scale(1.08);
      box-shadow: 0 12px 30px rgba(37, 211, 102, 0.5);
    }
    .wa-badge-pulse {
      position: absolute;
      top: -2px;
      right: -2px;
      width: 14px;
      height: 14px;
      background: #FF3B30;
      border: 2px solid #FFFFFF;
      border-radius: 50%;
    }

    /* Modal Backdrop */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(18, 26, 34, 0.65);
      backdrop-filter: blur(8px);
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .modal-backdrop.open {
      display: flex;
    }
    .modal-dialog {
      background: #FFFFFF;
      border-radius: var(--radius-md);
      max-width: 480px;
      width: 100%;
      max-height: 88vh;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 40px;
      position: relative;
      box-shadow: var(--shadow-lg);
      animation: modalFade 0.3s ease;
    }
    @keyframes modalFade {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .modal-close-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      background: none;
      border: none;
      font-size: 26px;
      color: var(--slate-400);
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s;
    }
    .modal-close-btn:hover {
      color: var(--slate-900);
    }

    /* -------------------------------------------------------------
       RESPONSIVE BREAKPOINTS
       ------------------------------------------------------------- */
    @media (max-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }
      .stat-box:nth-child(2) {
        border-right: none;
      }
      .reviews-grid {
        grid-template-columns: 1fr;
      }
      .faq-layout {
        grid-template-columns: 1fr;
      }
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .brand-logo-img {
        height: 38px;
        max-width: 180px;
      }
      .nav-menu, .nav-actions {
        display: none;
      }
      .menu-toggle {
        display: flex;
      }
      .section-py {
        padding: 64px 0;
      }
      .hero-section {
        height: auto;
        min-height: 720px;
        align-items: flex-end;
        padding: 0;
      }
      .hero-overlay-container {
        padding: 260px 16px 24px;
      }
      .hero-glass-card {
        padding: 24px 20px 22px;
      }
      .trans-header-badge,
      .hero-image-gradient-badge {
        display: none;
      }
      .trans-control-pill {
        bottom: auto;
        top: 215px;
        right: 14px;
      }
      .trans-handle {
        top: 130px;
      }
      .process-grid {
        grid-template-columns: 1fr;
      }
      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }
      .footer-grid {
        grid-template-columns: 1fr;
      }
      .fleet-studio-grid {
        grid-template-columns: 1fr;
      }
      .modal-dialog {
        padding: 28px 20px;
        max-height: 88vh;
      }
    }
    /* =============================================================
       FURNISWAP NEW FEATURES: UPLOAD, VALUATION, CALCULATOR,
       CUSTOMIZATION MODAL, CUSTOMER DASHBOARD, ADMIN DASHBOARD
       ============================================================= */

    /* Navigation Account Button */
    .btn-nav-account {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 16px;
      border-radius: var(--radius-sm);
      border: 1.5px solid var(--beige-border);
      background: #FFFFFF;
      color: var(--charcoal);
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s ease;
      white-space: nowrap;
    }
    .btn-nav-account:hover {
      border-color: var(--terracotta);
      color: var(--terracotta);
      box-shadow: var(--shadow-sm);
    }
    .btn-nav-account.logged-in {
      background: var(--terracotta-soft);
      border-color: var(--terracotta-border);
      color: var(--terracotta);
    }
    .user-avatar-badge {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--terracotta);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-weight: 700;
    }

    /* SECTION 1: OLD FURNITURE UPLOAD & INSTANT VALUATION */
    .valuation-section {
      background: var(--warm-cream-alt);
      border-top: 1px solid var(--beige-border);
      border-bottom: 1px solid var(--beige-border);
      position: relative;
    }
    .val-studio-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 32px;
      align-items: start;
      margin-top: 36px;
    }
    .val-card {
      background: #FFFFFF;
      border: 1.5px solid var(--beige-border);
      border-radius: var(--radius-lg);
      padding: 34px 30px;
      box-shadow: var(--shadow-md);
      position: relative;
    }
    .val-card-header {
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-light);
    }
    .val-step-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      background: var(--terracotta-soft);
      color: var(--terracotta);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .val-card-title {
      font-family: var(--font-heading);
      font-size: 24px;
      font-weight: 700;
      color: var(--charcoal);
      line-height: 1.2;
    }

    /* Dropzone */
    .photo-dropzone {
      border: 2px dashed var(--terracotta-border);
      background: var(--warm-cream);
      border-radius: var(--radius-md);
      padding: 24px 18px;
      text-align: center;
      cursor: pointer;
      transition: all 0.25s ease;
      position: relative;
    }
    .photo-dropzone:hover, .photo-dropzone.dragover {
      border-color: var(--terracotta);
      background: #FFFFFF;
      box-shadow: var(--shadow-sm);
    }
    .dropzone-icon {
      width: 44px;
      height: 44px;
      margin: 0 auto 10px;
      border-radius: 50%;
      background: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--terracotta);
      box-shadow: var(--shadow-sm);
    }
    .dropzone-text {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--charcoal);
      margin-bottom: 4px;
    }
    .dropzone-sub {
      font-size: 11.5px;
      color: var(--charcoal-muted);
    }
    .photo-previews-container {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }
    .photo-preview-item {
      position: relative;
      width: 72px;
      height: 72px;
      border-radius: 8px;
      overflow: hidden;
      border: 1.5px solid var(--beige-border);
      background: #000;
      box-shadow: var(--shadow-sm);
    }
    .photo-preview-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .photo-preview-remove {
      position: absolute;
      top: 3px;
      right: 3px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: rgba(26, 26, 26, 0.85);
      color: #FFFFFF;
      border: none;
      font-size: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s;
    }
    .photo-preview-remove:hover {
      background: var(--terracotta);
    }

    /* Form Fields */
    .form-group {
      margin-bottom: 18px;
    }
    .form-label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--charcoal);
      margin-bottom: 7px;
    }
    .form-label span.req {
      color: var(--terracotta);
    }
    .form-control {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid var(--border-light);
      border-radius: 8px;
      font-family: var(--font-body);
      font-size: 13.5px;
      color: var(--charcoal);
      background: #FFFFFF;
      transition: all 0.2s;
      box-sizing: border-box;
    }
    .form-control:focus {
      border-color: var(--terracotta);
      outline: none;
      box-shadow: 0 0 0 3px var(--terracotta-soft);
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .form-row-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
    }

    /* Condition Selector Chips */
    .condition-chips-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .cond-chip-btn {
      padding: 10px 12px;
      border: 1.5px solid var(--border-light);
      border-radius: 8px;
      background: #FFFFFF;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 500;
      color: var(--charcoal);
      cursor: pointer;
      text-align: left;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .cond-chip-btn strong {
      font-size: 13px;
      font-weight: 700;
    }
    .cond-chip-btn small {
      font-size: 10.5px;
      color: var(--charcoal-muted);
    }
    .cond-chip-btn:hover {
      border-color: var(--terracotta);
      color: var(--terracotta);
    }
    .cond-chip-btn.active {
      border-color: var(--terracotta);
      background: var(--terracotta-soft);
      color: var(--terracotta);
    }
    .cond-chip-btn.active small {
      color: var(--terracotta);
    }

    /* Valuation Result Card */
    .val-result-box {
      background: #FFFFFF;
      border: 1.5px solid var(--beige-border);
      border-radius: var(--radius-lg);
      padding: 30px 26px;
      box-shadow: var(--shadow-md);
      position: sticky;
      top: 100px;
    }
    .val-badge-est {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      background: var(--sage-soft);
      color: var(--sage);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .val-price-range {
      font-family: var(--font-heading);
      font-size: 38px;
      font-weight: 700;
      color: var(--charcoal);
      line-height: 1.1;
      margin-bottom: 6px;
    }
    .val-price-range span.curr {
      font-size: 22px;
      color: var(--terracotta);
      margin-right: 4px;
    }
    .val-breakdown-list {
      margin: 20px 0;
      padding: 16px 0;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
    }
    .val-breakdown-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      font-size: 13px;
    }
    .val-breakdown-label {
      color: var(--charcoal-muted);
    }
    .val-breakdown-val {
      font-weight: 600;
      color: var(--charcoal);
    }

    /* Required Prominent Disclaimer Box */
    .val-disclaimer-box {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 14px 16px;
      border-radius: var(--radius-sm);
      background: #FFF9F3;
      border: 1.5px solid rgba(196, 92, 42, 0.25);
      margin: 18px 0;
    }
    .val-disclaimer-icon {
      color: var(--terracotta);
      flex-shrink: 0;
      margin-top: 1px;
    }
    .val-disclaimer-text {
      font-size: 12px;
      line-height: 1.5;
      color: #7B3410;
      font-weight: 500;
    }
    .val-disclaimer-text strong {
      display: block;
      font-weight: 700;
      margin-bottom: 2px;
      color: var(--terracotta);
    }

    /* SECTION 2: SWAP CALCULATOR SECTION */
    .calculator-section {
      background: #FFFFFF;
      position: relative;
    }
    .calc-layout-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 32px;
      margin-top: 36px;
      align-items: start;
    }
    .calc-card {
      background: #FFFFFF;
      border: 1.5px solid var(--beige-border);
      border-radius: var(--radius-lg);
      padding: 32px;
      box-shadow: var(--shadow-md);
    }
    .calc-item-preview-banner {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 14px 16px;
      border-radius: var(--radius-md);
      background: var(--warm-cream-alt);
      border: 1px solid var(--beige-border);
      margin-top: 12px;
    }
    .calc-preview-thumb {
      width: 68px;
      height: 68px;
      border-radius: 8px;
      object-fit: cover;
      background: #fff;
      border: 1px solid var(--beige-border);
      flex-shrink: 0;
    }
    .calc-preview-details {
      flex: 1;
    }
    .calc-preview-title {
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 700;
      color: var(--charcoal);
      margin-bottom: 3px;
    }
    .calc-preview-sub {
      font-size: 12px;
      color: var(--charcoal-muted);
    }
    .calc-preview-price {
      font-weight: 700;
      color: var(--terracotta);
      font-size: 14px;
      margin-top: 3px;
    }

    /* Range Slider */
    .calc-slider-wrap {
      margin: 16px 0;
    }
    .calc-range-slider {
      width: 100%;
      height: 8px;
      border-radius: 4px;
      background: #EDE5D8;
      outline: none;
      -webkit-appearance: none;
      appearance: none;
      cursor: pointer;
    }
    .calc-range-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--terracotta);
      cursor: pointer;
      border: 3px solid #FFFFFF;
      box-shadow: var(--shadow-sm);
    }
    .calc-slider-labels {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--charcoal-muted);
      margin-top: 6px;
    }

    /* Live Receipt Card */
    .calc-receipt-box {
      background: var(--warm-cream-alt);
      border: 1.5px solid var(--beige-border);
      border-radius: var(--radius-lg);
      padding: 30px 26px;
      box-shadow: var(--shadow-md);
      position: sticky;
      top: 100px;
    }
    .receipt-header {
      padding-bottom: 14px;
      border-bottom: 1.5px dashed rgba(26, 26, 26, 0.15);
      margin-bottom: 16px;
    }
    .receipt-tag {
      font-size: 10.5px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--terracotta);
    }
    .receipt-title {
      font-family: var(--font-heading);
      font-size: 22px;
      font-weight: 700;
      color: var(--charcoal);
    }
    .receipt-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 9px 0;
      font-size: 13.5px;
    }
    .receipt-row.sub {
      font-size: 12.5px;
      color: var(--charcoal-muted);
      padding: 4px 0;
    }
    .receipt-credit-val {
