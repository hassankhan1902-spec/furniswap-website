      font-size: 11.5px;
      color: var(--charcoal-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 2px;
    }

    /* Submissions Card / Grid */
    .submissions-grid {
      display: flex;
      flex-direction: column;
      gap: 16px;
