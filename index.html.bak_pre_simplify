async function handleAdminAddNewCatalogueItem(e) {
  e.preventDefault();
  const name = document.getElementById('newItemName').value.trim();
  const nameUr = document.getElementById('newItemNameUr').value.trim() || name;
  const room = document.getElementById('newItemRoom').value;
  const tier = document.getElementById('newItemTier').value;
  const price = parseInt(document.getElementById('newItemPrice').value) || 50000;
  const image = document.getElementById('newItemImage').value.trim() || 'resources/photo-sofa.png';
  const sizes = document.getElementById('newItemSizes').value.trim() || 'Custom Size';
  const desc = document.getElementById('newItemDesc').value.trim();

  const newItem = {
    id: CATALOGUE_ITEMS.length + 1,
    name,
    name_ur: nameUr,
    room,
    roomLabel: room.charAt(0).toUpperCase() + room.slice(1),
    roomLabel_ur: room,
    tier,
    desc,
    desc_ur: desc,
    priceMin: price,
    priceMax: Math.round(price * 1.3),
    sizes,
    sizes_ur: sizes,
    icon: room === 'living' ? 'sofa' : room === 'bedroom' ? 'bed' : room === 'dining' ? 'dining' : 'wardrobe',
    image
  };

  CATALOGUE_ITEMS.push(newItem);
  await FurniDB.save('custom_catalogue', newItem);

  renderCatalogueGrid();
  initSwapCalculator();
  renderAdminCatalogue();
  toggleAdminNewItemForm();
  alert(`"${name}" has been added to the live FurniSwap catalogue!`);
}

// 10. EXPORT DATA & DEMO SEEDING
async function exportPlatformDataJSON() {
  const submissions = await FurniDB.getAll('submissions');
  const quotes = await FurniDB.getAll('quotes');
  const users = await FurniDB.getAll('users');

  const data = {
    exportDate: new Date().toISOString(),
    platform: 'FurniSwap Pakistan',
    submissions,
    quotes,
    users,
    catalogue: CATALOGUE_ITEMS
  };

  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `FurniSwap_Backup_${new Date().toISOString().slice(0, 10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

