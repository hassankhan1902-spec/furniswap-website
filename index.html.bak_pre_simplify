  const net = Math.max(0, itemPrice - credit);

  const quote = {
    id: 'FS-QUOTE-' + Date.now().toString(36).toUpperCase(),
    newItemName: item.name,
    newItemPrice: itemPrice,
    oldCredit: credit,
    netPayable: net,
    customSpecs: item.customSpecs || 'Standard Solid Wood',
    customerPhone: currentAuthUser ? currentAuthUser.phone : null,
    createdAt: new Date().toISOString()
  };

  await FurniDB.save('quotes', quote);
  alert(currentLang === 'ur' ? 'سوئیپ کوٹیشن آپ کے اکاؤنٹ میں محفوظ ہو گئی ہے!' : 'Swap calculation quote saved to your account!');

  if (currentAuthUser) {
    openCustomerPortal('quotes');
  } else {
    openAuthModal('register');
  }
}

