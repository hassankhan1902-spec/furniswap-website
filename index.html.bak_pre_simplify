// 1. STORAGE LAYER (IndexedDB with LocalStorage Fallback)
const FurniDB = {
  dbName: 'FurniSwapPlatformDB',
  version: 1,
  db: null,

  async init() {
    return new Promise((resolve) => {
      if (!window.indexedDB) {
        resolve(null);
        return;
      }
      try {
        const req = window.indexedDB.open(this.dbName, this.version);
        req.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains('submissions')) {
            db.createObjectStore('submissions', { keyPath: 'id' });
          }
          if (!db.objectStoreNames.contains('users')) {
            db.createObjectStore('users', { keyPath: 'id' });
          }
          if (!db.objectStoreNames.contains('quotes')) {
            db.createObjectStore('quotes', { keyPath: 'id' });
          }
          if (!db.objectStoreNames.contains('custom_catalogue')) {
            db.createObjectStore('custom_catalogue', { keyPath: 'id' });
          }
        };
        req.onsuccess = (e) => {
          this.db = e.target.result;
          resolve(this.db);
        };
        req.onerror = () => resolve(null);
      } catch (err) {
        resolve(null);
      }
    });
  },

  async save(storeName, item) {
    if (!item.id) item.id = 'FS_' + Date.now().toString(36).toUpperCase() + '_' + Math.random().toString(36).substr(2, 4).toUpperCase();
    item.updatedAt = new Date().toISOString();

    if (this.db) {
      return new Promise((resolve) => {
        try {
          const tx = this.db.transaction(storeName, 'readwrite');
          const store = tx.objectStore(storeName);
          store.put(item);
          tx.oncomplete = () => {
            this.syncLocalStorage(storeName, item);
            resolve(item);
          };
          tx.onerror = () => {
            this.saveLocalStorage(storeName, item);
            resolve(item);
          };
        } catch (e) {
          this.saveLocalStorage(storeName, item);
          resolve(item);
        }
      });
    } else {
      this.saveLocalStorage(storeName, item);
      return Promise.resolve(item);
    }
  },

  async getAll(storeName) {
    if (this.db) {
      return new Promise((resolve) => {
        try {
          const tx = this.db.transaction(storeName, 'readonly');
          const store = tx.objectStore(storeName);
          const req = store.getAll();
          req.onsuccess = () => {
            const list = req.result || [];
            if (!list.length) {
              resolve(this.getLocalStorage(storeName));
            } else {
              resolve(list);
            }
          };
          req.onerror = () => resolve(this.getLocalStorage(storeName));
        } catch (e) {
          resolve(this.getLocalStorage(storeName));
        }
      });
    }
    return Promise.resolve(this.getLocalStorage(storeName));
  },

  async delete(storeName, id) {
    if (this.db) {
      try {
        const tx = this.db.transaction(storeName, 'readwrite');
        tx.objectStore(storeName).delete(id);
      } catch (e) {}
    }
    const current = this.getLocalStorage(storeName).filter(x => x.id !== id);
    try {
      localStorage.setItem('furniswap_' + storeName, JSON.stringify(current));
    } catch (e) {}
  },

  getLocalStorage(storeName) {
    try {
      const data = localStorage.getItem('furniswap_' + storeName);
      return data ? JSON.parse(data) : [];
    } catch (e) {
      return [];
    }
  },

  saveLocalStorage(storeName, item) {
    try {
      const list = this.getLocalStorage(storeName);
      const idx = list.findIndex(x => x.id === item.id);
      if (idx >= 0) list[idx] = item;
      else list.unshift(item);
      localStorage.setItem('furniswap_' + storeName, JSON.stringify(list));
    } catch (e) {}
  },

  syncLocalStorage(storeName, item) {
    this.saveLocalStorage(storeName, item);
  }
};

