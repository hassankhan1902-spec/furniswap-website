        stat: "<strong>Single Coordinated Trip</strong> &mdash; room transformed with zero stress!",
        stat_ur: "<strong>سنگل ٹرپ ایکسچینج</strong> &mdash; بغیر کسی سر درد کے آپ کا کمرہ بدل گیا!"
      }
    ];

    let currentChainStep = 0;
    let isChainAutoPlaying = true;
    let isChainHovered = false;
    let chainProgressVal = 0;
    let chainProgressInterval = null;
    const STEP_DURATION = 9000;
    const TICK_INTERVAL = 50;

    function updateChainUI(stepIndex) {
      const data = CHAIN_DATA[stepIndex];
      if (!data) return;
      const isUr = currentLang === 'ur';

      // Update Node buttons
      document.querySelectorAll('.chain-node-item').forEach((node, idx) => {
        const isActive = idx === stepIndex;
        node.classList.toggle('active', isActive);
        node.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Update Catalyst Pills along the track
      document.querySelectorAll('.chain-catalyst-pill').forEach((pill, idx) => {
        const isPulse = idx === stepIndex || (stepIndex === 5 && idx === 4);
        pill.style.borderColor = isPulse ? 'var(--terracotta)' : 'var(--border-light)';
        pill.style.transform = isPulse ? 'translateX(-50%) scale(1.08)' : 'translateX(-50%) scale(1)';
        pill.style.boxShadow = isPulse ? '0 6px 16px rgba(196, 92, 42, 0.2)' : '0 4px 12px rgba(26, 26, 26, 0.08)';
      });

      // Update Traveling Glider Carrier with Stage Icon (6 stages)
      const gliderPositions = ['8.3%', '25%', '41.6%', '58.3%', '75%', '91.6%'];
      const gliderColors = ['var(--terracotta)', 'var(--sage)', 'var(--gold)', 'var(--charcoal)', 'var(--terracotta)', 'var(--sage)'];
      const gliderSvgs = [
        `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>`,
        `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>`,
        `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>`,
        `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/></svg>`,
        `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
        `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`
      ];

      const gliderEl = document.getElementById('chainGliderOrb');
      const gliderCore = document.getElementById('chainGliderCore');
      if (gliderEl && gliderPositions[stepIndex]) {
        gliderEl.style.left = gliderPositions[stepIndex];
      }
      if (gliderCore) {
        gliderCore.style.background = gliderColors[stepIndex];
        gliderCore.style.boxShadow = `0 4px 16px ${gliderColors[stepIndex]}66`;
        gliderCore.innerHTML = gliderSvgs[stepIndex];
      }

      // Update Spotlight Hero Badge
      const heroBadgeEl = document.getElementById('spotlightHeroBadge');
      if (heroBadgeEl) {
        heroBadgeEl.innerHTML = data.heroSvg;
        heroBadgeEl.style.background = data.heroBg;
        heroBadgeEl.style.borderColor = data.heroBorder;
      }

      // Update Spotlight Content
      const roleEl = document.getElementById('spotlightRole');
      const pillEl = document.getElementById('spotlightPill');
      const headingEl = document.getElementById('spotlightHeading');
      const descEl = document.getElementById('spotlightDesc');
      const actionRow = document.getElementById('spotlightActionRow');
      const perksList = document.getElementById('spotlightPerksList');
      const statEl = document.getElementById('spotlightStat');

      if (roleEl) roleEl.innerHTML = isUr ? data.role_ur : data.role;
      if (pillEl) pillEl.textContent = isUr ? data.pill_ur : data.pill;
      if (headingEl) headingEl.textContent = isUr ? data.heading_ur : data.heading;
      if (descEl) descEl.textContent = isUr ? data.desc_ur : data.desc;

      const ctaText = isUr ? data.ctaText_ur : data.ctaText;
      const ctaArrow = isUr ? '&larr;' : '&rarr;';
      if (actionRow) {
        if (data.ctaAction === 'modal') {
          actionRow.innerHTML = `<button class="spotlight-cta-btn" onclick="openAssessmentModal()"><span>${ctaText}</span> ${ctaArrow}</button>`;
        } else if (data.ctaAction === 'custom') {
          actionRow.innerHTML = `<button class="spotlight-cta-btn" onclick="launchWhatsAppCustomDesign()"><span>${ctaText}</span> ${ctaArrow}</button>`;
        } else {
          actionRow.innerHTML = `<a href="${data.ctaHref}" class="spotlight-cta-btn" ${data.ctaHref.startsWith('http') ? 'target="_blank" rel="noopener"' : ''}><span>${ctaText}</span> ${ctaArrow}</a>`;
        }
      }

      if (perksList) {
        perksList.innerHTML = data.perks.map(p => `
          <div class="spotlight-perk-item">
            <div class="spotlight-perk-icon-wrap" style="background:${p.iconBg}; color:${p.iconColor};">
              ${p.iconSvg}
            </div>
            <div>${isUr ? p.text_ur : p.text}</div>
          </div>
        `).join('');
      }

      if (statEl) {
        statEl.innerHTML = `
          <div style="width:22px; height:22px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; background:${data.heroBg}; color:${data.heroBorder};">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div>${isUr ? data.stat_ur : data.stat}</div>
        `;
      }

      chainProgressVal = 0;
      const progressEl = document.getElementById('chainTimerProgress');
      if (progressEl) progressEl.style.width = '0%';
    }

    function setChainStep(index, fromUser = false) {
      currentChainStep = index;
      updateChainUI(currentChainStep);
      if (fromUser && isChainAutoPlaying) {
        resetChainTimer();
      }
    }

    function nextChainStep() {
      currentChainStep = (currentChainStep + 1) % CHAIN_DATA.length;
      setChainStep(currentChainStep, true);
    }

    function prevChainStep() {
      currentChainStep = (currentChainStep - 1 + CHAIN_DATA.length) % CHAIN_DATA.length;
      setChainStep(currentChainStep, true);
    }

    function updateChainPlayButtonUI() {
      const playIcon = document.getElementById('chainPlayIcon');
      const playText = document.getElementById('chainPlayText');
      const isUr = currentLang === 'ur';
      if (isChainAutoPlaying) {
        if (playIcon) playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
        if (playText) playText.textContent = isUr ? 'روکیں' : 'Pause';
      } else {
        if (playIcon) playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
        if (playText) playText.textContent = isUr ? 'آٹو پلے' : 'Auto-Play';
      }
    }

    function toggleChainAutoPlay() {
      isChainAutoPlaying = !isChainAutoPlaying;
      updateChainPlayButtonUI();
      if (isChainAutoPlaying) {
        startChainTimer();
      } else {
        stopChainTimer();
        const progressEl = document.getElementById('chainTimerProgress');
        if (progressEl) progressEl.style.width = '0%';
      }
    }

    function startChainTimer() {
      stopChainTimer();
      chainProgressVal = 0;
      chainProgressInterval = setInterval(() => {
        if (!isChainAutoPlaying || isChainHovered) return;
        chainProgressVal += (TICK_INTERVAL / STEP_DURATION) * 100;
        const progressEl = document.getElementById('chainTimerProgress');
        if (progressEl) progressEl.style.width = Math.min(chainProgressVal, 100) + '%';

        if (chainProgressVal >= 100) {
          currentChainStep = (currentChainStep + 1) % CHAIN_DATA.length;
          updateChainUI(currentChainStep);
        }
      }, TICK_INTERVAL);
    }

    function stopChainTimer() {
      if (chainProgressInterval) {
        clearInterval(chainProgressInterval);
        chainProgressInterval = null;
      }
    }

    function resetChainTimer() {
      stopChainTimer();
      if (isChainAutoPlaying) {
        startChainTimer();
      }
    }

    // Mobile Drawer
    const menuToggle = document.getElementById('menuToggle');
    const mobileDrawer = document.getElementById('mobileDrawer');
    const drawerCloseBtn = document.getElementById('drawerCloseBtn');

    if (menuToggle && mobileDrawer) {
      menuToggle.addEventListener('click', () => {
        const isOpen = mobileDrawer.classList.contains('open');
        if (isOpen) closeDrawer();
        else openDrawer();
      });
    }

    if (drawerCloseBtn) {
      drawerCloseBtn.addEventListener('click', closeDrawer);
    }

    function openDrawer() {
      if (!mobileDrawer || !menuToggle) return;
      mobileDrawer.classList.add('open');
      menuToggle.classList.add('open');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!mobileDrawer || !menuToggle) return;
      mobileDrawer.classList.remove('open');
      menuToggle.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // Global Keydown Listeners (ESC key closes modal and drawer)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAssessmentModal();
        closeDrawer();
      }
    });

    // Scroll Progress & Nav Styling
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = totalHeight > 0 ? (scrollY / totalHeight) * 100 : 0;
      const tracker = document.getElementById('scrollTracker');
      if (tracker) tracker.style.width = progress + '%';

      const navEl = document.getElementById('mainNav');
      if (navEl) navEl.classList.toggle('scrolled', scrollY > 40);
    }, { passive: true });

    // -------------------------------------------------------------
    // SPACE TRANSFORMATION PLAYER CONTROLLER
    // -------------------------------------------------------------
    let transSplitPos = 50;
    let isTransAutoPlaying = true;
    let isTransDragging = false;
    let transAnimFrame = null;
    let transAnimStartTime = null;
    let transIdleResumeTimer = null;

    function setTransformationSplit(percent) {
      transSplitPos = Math.max(8, Math.min(92, percent));
      const stage = document.getElementById('transStage');
      const divider = document.getElementById('transDivider');
      if (stage) {
        stage.style.setProperty('--split-percent', transSplitPos + '%');
      }
      if (divider) {
        divider.setAttribute('aria-valuenow', Math.round(transSplitPos));
      }
    }

    function transAutoSweepLoop(timestamp) {
      if (!transAnimStartTime) transAnimStartTime = timestamp;
      if (isTransAutoPlaying && !isTransDragging) {
        const elapsed = (timestamp - transAnimStartTime) / 1000;
        // Smooth sine wave sweep between 22% and 78% over 6 seconds
        const sweep = 50 + 28 * Math.sin(elapsed * 1.05);
        setTransformationSplit(sweep);
      }
      transAnimFrame = requestAnimationFrame(transAutoSweepLoop);
    }

    function toggleTransformationPlay(e) {
      if (e) {
        e.stopPropagation();
        e.preventDefault();
      }
      isTransAutoPlaying = !isTransAutoPlaying;
      updateTransPlayButtonUI();
      if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
    }

    function updateTransPlayButtonUI() {
      const playIcon = document.getElementById('transPlayIcon');
      const playText = document.getElementById('transPlayText');
      const isUr = currentLang === 'ur';
      if (isTransAutoPlaying) {
        if (playIcon) {
          playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
        }
        if (playText) playText.textContent = isUr ? 'روکیں' : 'Pause';
      } else {
        if (playIcon) {
          playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
        }
        if (playText) playText.textContent = isUr ? 'چلائیں' : 'Play';
      }
    }

    function initTransformationPlayer() {
      const stage = document.getElementById('transStage');
      if (!stage) return;

      // Auto-detect HTML5 video if transformation.mp4 is provided in resources
      const videoEl = document.getElementById('heroTransformVideo');
      if (videoEl) {
        videoEl.addEventListener('canplay', () => {
          videoEl.style.display = 'block';
          videoEl.play().catch(() => {});
        });
      }

      function handleDragMove(clientX) {
        if (clientX === undefined) return;
        const rect = stage.getBoundingClientRect();
        const offsetX = clientX - rect.left;
        const percent = (offsetX / rect.width) * 100;
        setTransformationSplit(percent);
      }

      function onMouseDown(e) {
        isTransDragging = true;
        stage.classList.add('is-dragging');
        if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
        handleDragMove(e.clientX);
      }

      function onMouseMove(e) {
        if (!isTransDragging) return;
        handleDragMove(e.clientX);
      }

      function onMouseUp() {
        if (!isTransDragging) return;
        isTransDragging = false;
        stage.classList.remove('is-dragging');
        if (isTransAutoPlaying) {
          if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
          transIdleResumeTimer = setTimeout(() => {
            const currentRatio = Math.max(-1, Math.min(1, (transSplitPos - 50) / 28));
            transAnimStartTime = performance.now() - (Math.asin(currentRatio) / 1.05) * 1000;
          }, 3500);
        }
      }

      let touchStartX = null;
      let touchStartY = null;
      let touchIsScrolling = null;

      function onTouchStart(e) {
        if (!e.touches || !e.touches[0]) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchIsScrolling = null;
        isTransDragging = true;
        stage.classList.add('is-dragging');
        if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
      }

      function onTouchMove(e) {
        if (!isTransDragging || !e.touches || !e.touches[0]) return;
        const currentX = e.touches[0].clientX;
        const currentY = e.touches[0].clientY;
        const deltaX = Math.abs(currentX - touchStartX);
        const deltaY = Math.abs(currentY - touchStartY);

        if (touchIsScrolling === null && (deltaX > 6 || deltaY > 6)) {
          if (deltaY > deltaX) {
            touchIsScrolling = true;
            isTransDragging = false;
            stage.classList.remove('is-dragging');
            return;
          } else {
            touchIsScrolling = false;
          }
        }

        if (touchIsScrolling === false) {
          handleDragMove(currentX);
        }
      }

      function onTouchEnd() {
        if (isTransDragging) {
          isTransDragging = false;
          stage.classList.remove('is-dragging');
          if (isTransAutoPlaying) {
            if (transIdleResumeTimer) clearTimeout(transIdleResumeTimer);
            transIdleResumeTimer = setTimeout(() => {
              const currentRatio = Math.max(-1, Math.min(1, (transSplitPos - 50) / 28));
              transAnimStartTime = performance.now() - (Math.asin(currentRatio) / 1.05) * 1000;
            }, 3500);
          }
        }
        touchStartX = null;
        touchStartY = null;
        touchIsScrolling = null;
      }

      stage.addEventListener('mousedown', onMouseDown);
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);

      stage.addEventListener('touchstart', onTouchStart, { passive: true });
      window.addEventListener('touchmove', onTouchMove, { passive: true });
      window.addEventListener('touchend', onTouchEnd, { passive: true });

      // Keyboard Accessibility for Slider
      const divider = document.getElementById('transDivider');
      if (divider) {
        divider.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
            e.preventDefault();
            setTransformationSplit(transSplitPos - 5);
          } else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
            e.preventDefault();
            setTransformationSplit(transSplitPos + 5);
          }
        });
      }

      setTransformationSplit(50);
      transAnimFrame = requestAnimationFrame(transAutoSweepLoop);
    }

    // -------------------------------------------------------------
    // ARTISAN WORKSHOP & CRAFTSMANSHIP VIDEO CONTROLLER
    // -------------------------------------------------------------
    let isArtisanVideoPlaying = false;

    function toggleArtisanVideo(e) {
      if (e) {
        e.stopPropagation();
        e.preventDefault();
      }
      const video = document.getElementById('artisanVideo');
      const frame = document.getElementById('artisanVideoFrame');
      const playIcon = document.getElementById('artisanPlayIcon');
      const caption = document.getElementById('artisanPlayCaption');
      const isUr = currentLang === 'ur';

      if (!video) return;

      if (video.paused) {
        if (isTransAutoPlaying) {
          isTransAutoPlaying = false;
          updateTransPlayButtonUI();
        }

        video.play().then(() => {
          isArtisanVideoPlaying = true;
          if (frame) frame.classList.add('is-playing');
          if (playIcon) playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
          if (caption) caption.textContent = isUr ? 'روکیں' : 'Pause Video';
        }).catch(() => {
          isArtisanVideoPlaying = true;
          if (frame) frame.classList.add('is-playing');
          if (playIcon) playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
          if (caption) caption.textContent = isUr ? 'ورکشاپ جھلک' : 'Workshop Preview';
        });
      } else {
        video.pause();
        isArtisanVideoPlaying = false;
        if (frame) frame.classList.remove('is-playing');
        if (playIcon) playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
        if (caption) caption.textContent = isUr ? 'کاریگروں کی ویڈیو دیکھیں' : 'Watch Workshop Video';
      }
    }

    function toggleArtisanMute(e) {
      if (e) {
        e.stopPropagation();
        e.preventDefault();
      }
      const video = document.getElementById('artisanVideo');
      const muteIcon = document.getElementById('artisanMuteIcon');
      if (!video) return;

      video.muted = !video.muted;
      if (muteIcon) {
        if (video.muted) {
          muteIcon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>';
        } else {
          muteIcon.innerHTML = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>';
        }
      }
    }

    function selectCraftStory(index) {
      const cards = document.querySelectorAll('.artisan-story-card');
      cards.forEach((c, i) => {
        c.classList.toggle('active', i === index);
      });
      const frame = document.getElementById('artisanVideoFrame');
      if (frame) {
        frame.style.transform = 'scale(1.015)';
        setTimeout(() => { frame.style.transform = ''; }, 300);
      }
    }

    function initArtisanVideo() {
      const video = document.getElementById('artisanVideo');
      const timeIndicator = document.getElementById('artisanTimeIndicator');
      if (!video) return;

      video.addEventListener('timeupdate', () => {
        if (!timeIndicator || !video.duration) return;
        const curMin = Math.floor(video.currentTime / 60);
        const curSec = Math.floor(video.currentTime % 60).toString().padStart(2, '0');
        const durMin = Math.floor(video.duration / 60);
        const durSec = Math.floor(video.duration % 60).toString().padStart(2, '0');
        timeIndicator.textContent = `${curMin}:${curSec} / ${durMin}:${durSec}`;
      });

      video.addEventListener('ended', () => {
        isArtisanVideoPlaying = false;
        const frame = document.getElementById('artisanVideoFrame');
        const playIcon = document.getElementById('artisanPlayIcon');
        const caption = document.getElementById('artisanPlayCaption');
        const isUr = currentLang === 'ur';
        if (frame) frame.classList.remove('is-playing');
        if (playIcon) playIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
        if (caption) caption.textContent = isUr ? 'دوبارہ دیکھیں' : 'Replay Video';
      });
    }

    // INITIALIZATION (FAIL-SAFE READY STATE)
    function initAll() {
      setLanguage(currentLang);
      updateChainUI(0);
      startChainTimer();
      initTransformationPlayer();
      initArtisanVideo();

      // Pause swap chain auto-play while reading or hovering over the board
      const swapBoardEl = document.getElementById('swapChainBoard');
      if (swapBoardEl) {
        swapBoardEl.addEventListener('mouseenter', () => { isChainHovered = true; });
        swapBoardEl.addEventListener('mouseleave', () => { isChainHovered = false; });
        swapBoardEl.addEventListener('focusin', () => { isChainHovered = true; });
        swapBoardEl.addEventListener('focusout', () => { isChainHovered = false; });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</body>
</html>
