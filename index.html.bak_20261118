      { id: 7, name: 'Modern Dining Set (4-Seater)', name_ur: 'جدید 4 سیٹر ڈائننگ سیٹ', room: 'dining', roomLabel: 'Dining Room', roomLabel_ur: 'ڈائننگ روم', tier: 'economy', desc: 'Solid wood dining table with 4 comfortable chairs. Scratch-resistant and easy to wipe clean.', desc_ur: 'ٹھوس لکڑی کی میز اور 4 آرام دہ کرسیاں، داغ دھبوں اور کھرچ سے محفوظ۔', priceMin: 30000, priceMax: 50000, sizes: '4 Chairs + Table', sizes_ur: '4 کرسیاں مع میز', icon: 'dining', image: 'resources/photo-dining.png' },
      { id: 8, name: 'Extendable Dining Suite (6-Seater)', name_ur: 'ایکسٹینڈ ایبل 6 سیٹر ڈائننگ سیٹ', room: 'dining', roomLabel: 'Dining Room', roomLabel_ur: 'ڈائننگ روم', tier: 'standard', desc: 'Extendable dining table that easily seats 6 people, with soft padded chairs.', desc_ur: 'کشادہ ہونے والی میز جس پر 6 افراد آسانی سے بیٹھ سکتے ہیں، مع آرام دہ کرسیاں۔', priceMin: 60000, priceMax: 90000, sizes: '6 Chairs + Table', sizes_ur: '6 کرسیاں مع میز', icon: 'dining', image: 'resources/photo-dining.png' },
      { id: 9, name: 'Marble-Top Dining Set (8-Seater)', name_ur: 'ماربل ٹاپ 8 سیٹر شاہی ڈائننگ سیٹ', room: 'dining', roomLabel: 'Dining Room', roomLabel_ur: 'ڈائننگ روم', tier: 'premium', desc: 'Beautiful marble-top dining table with 8 soft velvet chairs. Perfect for big family dinners.', desc_ur: 'قدرتی ماربل کی خوبصورت میز اور 8 مخملی کرسیاں، خاندانی ضیافتوں کے لیے لاجواب۔', priceMin: 110000, priceMax: 180000, sizes: '8 Chairs + Table', sizes_ur: '8 کرسیاں مع میز', icon: 'dining', image: 'resources/photo-dining.png' },
      { id: 10, name: 'Contemporary 2-Door Wardrobe', name_ur: 'ماڈرن 2 دروازوں والی الماری', room: 'storage', roomLabel: 'Storage', roomLabel_ur: 'الماری / وارڈروب', tier: 'economy', desc: 'Spacious 2-door cupboard with a strong hanging rail and overhead storage space.', desc_ur: '2 دروازوں والی کشادہ الماری، مضبوط ہینگر راڈ اور اوپر سامان رکھنے کی گنجائش۔', priceMin: 22000, priceMax: 38000, sizes: '2-Door Cupboard', sizes_ur: '2 ڈور الماری', icon: 'wardrobe', image: 'resources/photo-credenza.png' },
      { id: 11, name: '3-Door Mirrored Wardrobe', name_ur: '3 دروازوں والی شیشے دار وارڈروب', room: 'storage', roomLabel: 'Storage', roomLabel_ur: 'الماری / وارڈروب', tier: 'standard', desc: '3-door cupboard with a full-length dressing mirror and smooth organizer drawers.', desc_ur: 'مکمل قد کا ڈریسنگ آئینہ، 3 دروازے اور ہموار آرگنائزر درازیں۔', priceMin: 42000, priceMax: 68000, sizes: '3-Door Cupboard', sizes_ur: '3 ڈور الماری', icon: 'wardrobe', image: 'resources/photo-credenza.png' },
      { id: 12, name: 'Modular Walk-In Wardrobe Unit', name_ur: 'ماڈیولر واک اِن وارڈروب یونٹ', room: 'storage', roomLabel: 'Storage', roomLabel_ur: 'الماری / وارڈروب', tier: 'premium', desc: 'Spacious walk-in wardrobe with warm lights, glass shelves, and lots of organized storage.', desc_ur: 'لائٹس، شیشے کے شیلف اور وسیع اسٹوریج سے آراستہ ڈیزائنر واک اِن الماری۔', priceMin: 90000, priceMax: 150000, sizes: 'Walk-In Wardrobe', sizes_ur: 'واک اِن وارڈروب', icon: 'wardrobe', image: 'resources/photo-credenza.png' }
    ];

    // FURNITURE CATALOGUE LOGIC
    let catFilter = { room: 'all', tier: 'all' };

    function renderFurnitureSVG(type, tier) {
      const colors = {
        economy: { main: '#4A6741', dark: '#374E30', light: '#8DAF84', leg: '#253520' }, // Sage Green Accent
        standard: { main: '#C45C2A', dark: '#9E441A', light: '#E8A583', leg: '#6E2E0E' }, // Terracotta Primary
        premium: { main: '#2B2B2B', dark: '#1A1A1A', light: '#D7C6B3', leg: '#141414' }  // Charcoal & Beige
      }[tier] || { main: '#C45C2A', dark: '#9E441A', light: '#E8A583', leg: '#6E2E0E' };

      if (type === 'sofa') {
        return `<svg viewBox="0 0 100 56" width="100%" height="80"><rect x="2" y="12" width="96" height="24" rx="5" fill="${colors.main}"/><rect x="2" y="12" width="14" height="30" rx="5" fill="${colors.dark}"/><rect x="84" y="12" width="14" height="30" rx="5" fill="${colors.dark}"/><rect x="16" y="30" width="68" height="12" rx="3" fill="${colors.light}"/><line x1="50" y1="14" x2="50" y2="29" stroke="${colors.dark}" stroke-width="2" opacity="0.4" stroke-linecap="round"/><rect x="14" y="42" width="10" height="8" rx="2" fill="${colors.leg}"/><rect x="76" y="42" width="10" height="8" rx="2" fill="${colors.leg}"/></svg>`;
      }
      if (type === 'bed') {
        return `<svg viewBox="0 0 100 62" width="100%" height="80"><rect x="2" y="6" width="96" height="16" rx="5" fill="${colors.dark}"/><rect x="2" y="20" width="96" height="30" rx="4" fill="${colors.main}"/><rect x="8" y="24" width="36" height="14" rx="4" fill="${colors.light}" opacity="0.85"/><rect x="56" y="24" width="36" height="14" rx="4" fill="${colors.light}" opacity="0.85"/><rect x="2" y="48" width="96" height="6" rx="2" fill="${colors.dark}"/><rect x="6" y="50" width="10" height="8" rx="2" fill="${colors.leg}"/><rect x="84" y="50" width="10" height="8" rx="2" fill="${colors.leg}"/></svg>`;
      }
      if (type === 'dining') {
        return `<svg viewBox="0 0 100 62" width="100%" height="80"><rect x="0" y="16" width="18" height="22" rx="4" fill="${colors.main}"/><rect x="3" y="38" width="12" height="10" rx="2" fill="${colors.dark}"/><rect x="82" y="16" width="18" height="22" rx="4" fill="${colors.main}"/><rect x="85" y="38" width="12" height="10" rx="2" fill="${colors.dark}"/><rect x="16" y="22" width="68" height="10" rx="4" fill="${colors.dark}"/><rect x="24" y="32" width="8" height="18" rx="2" fill="${colors.main}"/><rect x="68" y="32" width="8" height="18" rx="2" fill="${colors.main}"/></svg>`;
      }
      return `<svg viewBox="0 0 80 90" width="70" height="80"><rect x="2" y="2" width="76" height="80" rx="5" fill="${colors.main}"/><rect x="2" y="2" width="76" height="10" rx="5" fill="${colors.dark}"/><line x1="40" y1="12" x2="40" y2="82" stroke="${colors.dark}" stroke-width="2.5" opacity="0.6"/><rect x="30" y="42" width="6" height="10" rx="3" fill="${colors.dark}"/><rect x="44" y="42" width="6" height="10" rx="3" fill="${colors.dark}"/><rect x="8" y="82" width="14" height="6" rx="2" fill="${colors.leg}"/><rect x="58" y="82" width="14" height="6" rx="2" fill="${colors.leg}"/></svg>`;
    }

    function filterCatalogue(type, value, btn) {
      if (type === 'room') {
        catFilter.room = value;
        document.querySelectorAll('#roomFilterPills .cat-filter-btn').forEach(b => b.classList.remove('active'));
      } else {
        catFilter.tier = value;
        document.querySelectorAll('#tierFilterPills .cat-filter-btn').forEach(b => b.classList.remove('active'));
      }
      if (btn) btn.classList.add('active');
      renderCatalogueGrid();
    }

    function renderCatalogueGrid() {
      const grid = document.getElementById('catalogueGrid');
      if (!grid) return;
      const isUr = currentLang === 'ur';

      const filtered = CATALOGUE_ITEMS.filter(item => {
        const roomMatch = catFilter.room === 'all' || item.room === catFilter.room;
        const tierMatch = catFilter.tier === 'all' || item.tier === catFilter.tier;
        return roomMatch && tierMatch;
      });

      if (!filtered.length) {
        grid.innerHTML = isUr
          ? `<div style="grid-column:1/-1; text-align:center; padding:48px 0; color:var(--slate-400);">اس انتخاب میں کوئی فرنیچر دستیاب نہیں۔ براہِ کرم &ldquo;تمام فرنیچر&rdquo; منتخب کریں۔</div>`
          : `<div style="grid-column:1/-1; text-align:center; padding:48px 0; color:var(--slate-400);">No items found for this selection. Try choosing &ldquo;All Items&rdquo;.</div>`;
        return;
      }

      grid.innerHTML = filtered.map(item => {
        const tierLabel = isUr
          ? (item.tier === 'economy' ? 'بجٹ فرینڈلی' : item.tier === 'standard' ? 'اسٹینڈرڈ کوالٹی' : 'لگژری کوالٹی')
          : (item.tier === 'economy' ? 'BUDGET' : item.tier === 'standard' ? 'STANDARD' : 'LUXURY');

        const tierColor = item.tier === 'economy' ? 'var(--teal)' : item.tier === 'standard' ? 'var(--coral)' : 'var(--gold)';
        const tierBg = item.tier === 'economy' ? 'var(--teal-soft)' : item.tier === 'standard' ? 'var(--coral-soft)' : 'var(--gold-soft)';

        const itemName = isUr ? item.name_ur : item.name;
        const itemDesc = isUr ? item.desc_ur : item.desc;
        const itemRoomLabel = isUr ? item.roomLabel_ur : item.roomLabel;
        const itemSizes = isUr ? item.sizes_ur : item.sizes;

        const waText = isUr
          ? `السلام علیکم فرنی سواپ! میں اپنا پرانا فرنیچر دے کر ${item.name} (${tierLabel}) لینا چاہتا ہوں۔ براہ کرم قیمت اور دستیابی بتائیں۔`
          : `Hi FurniSwap! I want to swap my old furniture for the ${item.name} (${tierLabel} tier). Please tell me price and availability!`;

        const priceLabel = isUr ? 'تخمینی قیمت' : 'Estimated Price';
        const priceVal = isUr
          ? `${(item.priceMin/1000).toFixed(0)} ہزار تا ${(item.priceMax/1000).toFixed(0)} ہزار روپے`
          : `Rs. ${(item.priceMin/1000).toFixed(0)}K &ndash; ${(item.priceMax/1000).toFixed(0)}K`;

        const swapBtnText = isUr ? 'اس کے ساتھ تبدیل کریں &larr;' : 'Swap for this &rarr;';

        const previewContent = item.image
          ? `<img src="${item.image}" alt="${itemName}" class="cat-card-img" loading="lazy">`
          : renderFurnitureSVG(item.icon, item.tier);

        return `
          <div class="cat-item-card">
            <div class="cat-card-preview">
              ${previewContent}
            </div>
            <div class="cat-card-body">
              <div class="cat-meta-row">
                <span class="cat-tier-badge" style="background:${tierBg}; color:${tierColor};">${tierLabel}</span>
                <span class="cat-room-tag">${itemRoomLabel} &middot; ${itemSizes}</span>
              </div>
              <h4 class="cat-card-title">${itemName}</h4>
              <p class="cat-card-desc">${itemDesc}</p>
              <div class="cat-card-footer">
                <div>
                  <div style="font-size:10px; color:var(--slate-400); text-transform:uppercase; letter-spacing:0.5px;">${priceLabel}</div>
                  <div class="cat-price-val">${priceVal}</div>
                </div>
                <a href="https://wa.me/923437761250?text=${encodeURIComponent(waText)}" class="cat-btn-enquire" target="_blank" rel="noopener">
                  ${swapBtnText}
                </a>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // FAQ ACCORDION LOGIC
    function toggleFaq(btn) {
      const item = btn.closest('.faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('open');

      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) {
        item.classList.add('open');
      }
    }

    // MODAL & DRAWER LOGIC
    function openAssessmentModal() {
      const modal = document.getElementById('assessmentModal');
      if (modal) modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeAssessmentModal() {
      const modal = document.getElementById('assessmentModal');
      if (modal) modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    function launchWhatsAppSwap(choice) {
      const isUr = currentLang === 'ur';
      const msg = isUr
        ? `السلام علیکم فرنی سواپ! میں اپنا پرانا فرنیچر تبدیل کروانے کے لیے مفت تخمینہ چاہتا ہوں۔ تبدیل کرنے والا سامان: ${choice}۔ رہنمائی فرمائیں۔`
        : `Hi FurniSwap! I would like a free price check to swap my furniture. I want to swap: ${choice}. Please let me know the next steps!`;
      window.open(`https://wa.me/923437761250?text=${encodeURIComponent(msg)}`, '_blank');
      closeAssessmentModal();
    }

    function launchWhatsAppCustomDesign() {
      const isUr = currentLang === 'ur';
      const msg = isUr
        ? `السلام علیکم فرنی سواپ! میرے پاس فرنیچر کا کسٹم ڈیزائن/تصویر ہے اور میں اپنے پرانے فرنیچر کے کریڈٹ کے ساتھ نیا من پسند فرنیچر بنوانا چاہتا ہوں۔ رہنمائی فرمائیں۔`
        : `Hi FurniSwap! I have a custom furniture design / reference sketch in mind. I would like to use credit from my existing furniture to co-design and craft this bespoke piece. Please let me know how we can proceed!`;
      window.open(`https://wa.me/923437761250?text=${encodeURIComponent(msg)}`, '_blank');
    }

