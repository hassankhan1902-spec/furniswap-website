  <!-- -------------------------------------------------------------
       ASSESSMENT MODAL
       ------------------------------------------------------------- -->
  <div class="modal-backdrop" id="assessmentModal" onclick="if(event.target===this) closeAssessmentModal()">
    <div class="modal-dialog">
      <button class="modal-close-btn" onclick="closeAssessmentModal()" aria-label="Close modal">&times;</button>
      <div style="font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--coral); font-weight:700; margin-bottom:8px;" data-i18n="modal_tag">
        Free 30-Minute Price Check
      </div>
      <h3 style="font-family:var(--font-heading); font-size:28px; font-weight:700; color:var(--slate-900); line-height:1.2; margin-bottom:10px;" data-i18n="modal_title">
        What would you like to swap?
      </h3>
      <p style="font-size:13.5px; color:var(--slate-600); margin-bottom:24px;" data-i18n="modal_desc">
        Pick an option below and chat with our team on WhatsApp:
      </p>

      <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:12px; margin-bottom:16px;">
        <button onclick="launchWhatsAppSwap('Living Room / Sofa Suite')" style="padding:16px 12px; border:1.5px solid var(--border-light); border-radius:8px; background:#fff; font-size:14px; font-weight:700; color:var(--slate-900); cursor:pointer; text-align:left; transition:all 0.2s;" onmouseover="this.style.borderColor='var(--coral)';this.style.color='var(--coral)'" onmouseout="this.style.borderColor='var(--border-light)';this.style.color='var(--slate-900)'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px; margin-right:4px;"><path d="M4 11V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"/><rect x="2" y="11" width="20" height="7" rx="2"/><path d="M6 18v2"/><path d="M18 18v2"/></svg> <span data-i18n="modal_sofa_title">Sofa Set</span>
          <div style="font-size:11px; color:var(--slate-400); font-weight:400; margin-top:4px;" data-i18n="modal_sofa_sub">3+2, 5 or 7 Seats</div>
        </button>

        <button onclick="launchWhatsAppSwap('Master Bedroom Suite')" style="padding:16px 12px; border:2px solid var(--coral); border-radius:8px; background:var(--coral-soft); font-size:14px; font-weight:700; color:var(--coral); cursor:pointer; text-align:left; transition:all 0.2s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px; margin-right:4px;"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg> <span data-i18n="modal_bed_title">Bed &amp; Wardrobe</span>
          <div style="font-size:11px; color:var(--coral); font-weight:500; margin-top:4px;" data-i18n="modal_bed_sub">Master Bed / Storage</div>
        </button>

        <button onclick="launchWhatsAppSwap('Dining Room Set')" style="padding:16px 12px; border:1.5px solid var(--border-light); border-radius:8px; background:#fff; font-size:14px; font-weight:700; color:var(--slate-900); cursor:pointer; text-align:left; transition:all 0.2s;" onmouseover="this.style.borderColor='var(--coral)';this.style.color='var(--coral)'" onmouseout="this.style.borderColor='var(--border-light)';this.style.color='var(--slate-900)'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px; margin-right:4px;"><path d="M3 3v18"/><path d="M21 3v18"/><path d="M3 9h18"/><path d="M8 9v12"/><path d="M16 9v12"/></svg> <span data-i18n="modal_dining_title">Dining Table</span>
          <div style="font-size:11px; color:var(--slate-400); font-weight:400; margin-top:4px;" data-i18n="modal_dining_sub">4, 6 or 8 Chairs</div>
        </button>

        <button onclick="launchWhatsAppSwap('Bespoke Custom Furniture with Reference Sketch')" style="padding:16px 12px; border:1.5px solid var(--border-light); border-radius:8px; background:#fff; font-size:14px; font-weight:700; color:var(--slate-900); cursor:pointer; text-align:left; transition:all 0.2s;" onmouseover="this.style.borderColor='var(--coral)';this.style.color='var(--coral)'" onmouseout="this.style.borderColor='var(--border-light)';this.style.color='var(--slate-900)'">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px; margin-right:4px;"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg> <span data-i18n="modal_rooms_title">Bespoke Design</span>
          <div style="font-size:11px; color:var(--slate-400); font-weight:400; margin-top:4px;" data-i18n="modal_rooms_sub">Reference / Custom Fit</div>
        </button>
      </div>

      <!-- BRAND KIT PAGE 9 & 10: TRANSPARENT QUOTATION SUMMARY -->
      <div class="quotation-summary-card">
        <div class="qsc-header">
          <span class="qsc-tag" data-i18n="qsc_tag">Transparent Quotation Format</span>
          <span class="qsc-brand">FURNISWAP &bull; DESIGN + SWAP</span>
        </div>
        <div class="qsc-item-row">
          <div class="qsc-label" data-i18n="qsc_design_label">Requested Design:</div>
          <div class="qsc-val" data-i18n="qsc_design_val">Bespoke 5-Seater Sofa / Bed Suite</div>
        </div>
        <div class="qsc-item-row">
          <div class="qsc-label" data-i18n="qsc_mat_label">Materials &amp; Dimensions:</div>
          <div class="qsc-val" data-i18n="qsc_mat_val">Solid Acacia Frame &bull; Premium Linen &bull; Custom Fit</div>
        </div>
        <div class="qsc-divider"></div>
        <div class="qsc-math-row">
          <span data-i18n="qsc_price_label">Approved Custom Price:</span>
          <span class="qsc-math-val">Rs. 95,000</span>
        </div>
        <div class="qsc-math-row">
          <span data-i18n="qsc_credit_label">Less: Swap Credit (Old Furniture):</span>
          <span class="qsc-math-val" style="color:var(--sage);">-Rs. 35,000</span>
        </div>
        <div class="qsc-total-row">
          <span data-i18n="qsc_balance_label">Net Customer Balance:</span>
          <span class="qsc-total-val" style="color:var(--terracotta);">Rs. 60,000</span>
        </div>
        <div class="qsc-footer-note" data-i18n="qsc_note">
          &#10003; Includes 1-Trip Delivery, In-Room Assembly &amp; Old Furniture Removal (Rs. 0)
        </div>
      </div>

      <div style="text-align:center; font-size:12px; color:var(--slate-400);" data-i18n="modal_guarantee">
        &#10003; 100% Free price check &nbsp;&middot;&nbsp; No obligation &nbsp;&middot;&nbsp; Reply in ~30 mins
      </div>
    </div>
  </div>

