    function setLanguage(lang) {
      currentLang = (lang === 'ur') ? 'ur' : 'en';
      localStorage.setItem('furniswap_lang', currentLang);
      document.documentElement.lang = currentLang;
      document.documentElement.dir = (currentLang === 'ur') ? 'rtl' : 'ltr';

      document.querySelectorAll('.lang-btn').forEach(btn => {
        const isActive = btn.dataset.lang === currentLang;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      applyTranslations(currentLang);
      if (typeof updateChainUI === 'function') updateChainUI(currentChainStep);
      renderCatalogueGrid();
      if (typeof updateTransPlayButtonUI === 'function') updateTransPlayButtonUI();
      if (typeof updateChainPlayButtonUI === 'function') updateChainPlayButtonUI();
    }

    function applyTranslations(lang) {
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (I18N_DICT[key] && I18N_DICT[key][lang] !== undefined) {
          el.innerHTML = I18N_DICT[key][lang];
        }
      });
    }

