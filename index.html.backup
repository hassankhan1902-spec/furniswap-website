    economy: {
      '1BR': { price:'3,80,000', items:['1 Sofa set (3+2 seater — 5 seat)','1 Bed frame','1 Wardrobe (2 door)','1 Dining table + 4 chairs','Free delivery & installation','Old furniture collected'] },
