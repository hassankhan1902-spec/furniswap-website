      '10 Marla':{ price:'13,00,000', items:['Drawing room: sofa set (3+2+1 seater — 6 seat)','TV lounge: 5 seater sofa','4 Bed frames','4 Wardrobes (2 door each)','1 Dining table + 8 chairs','Free delivery & installation','Old furniture collected'] },
      '1 Kanal': { price:'19,00,000', items:['Drawing room: L-shape sofa (7 seat)','TV lounge: 3+2 seater sofa (5 seat)','5 Bed frames','5 Wardrobes (2 door each)','1 Dining table + 10 chairs','Free delivery & installation','Old furniture collected'] },
      '2 Kanal': { price:'28,00,000', items:['Drawing room: L-shape sofa (9 seat)','TV lounge: 3+2+1 seater sofa (6 seat)','6 Bed frames','6 Wardrobes (2 door each)','1 Dining table + 12 chairs','Free delivery & installation','Old furniture collected'] },
      '5 Kanal': { price:'48,00,000', items:['Drawing room: Full suite sofa (11 seat)','TV lounge: L-shape sofa (7 seat)','7 Bed frames','7 Wardrobes (2 door each)','1 Dining table + 14 chairs','Free delivery & installation','Old furniture collected'] }
    },
    standard: {
      '5 Marla': { price:'16,00,000', items:['Drawing room: Premium sofa (3+2 seater — 5 seat)','TV lounge: Premium 3 seater','3 Bed frames','3 Wardrobes (3 door each)','1 Dining table + 6 chairs','6 Bedside tables','Coffee + side tables','Free delivery & installation','Old furniture collected'] },
      '10 Marla':{ price:'24,00,000', items:['Drawing room: Premium sofa (3+2+1 seater — 6 seat)','TV lounge: Premium 5 seater','4 Bed frames','4 Wardrobes (3 door each)','1 Dining table + 8 chairs','8 Bedside tables','Coffee + 2 side tables','Free delivery & installation','Old furniture collected'] },
      '1 Kanal': { price:'35,00,000', items:['Drawing room: Premium L-shape sofa (7 seat)','TV lounge: Premium 3+2 seater (5 seat)','5 Bed frames','5 Wardrobes (3 door each)','1 Dining table + 10 chairs','10 Bedside tables','Coffee + 4 side tables','Free delivery & installation','Old furniture collected'] },
      '2 Kanal': { price:'50,00,000', items:['Drawing room: Premium L-shape sofa (9 seat)','TV lounge: Premium 3+2+1 seater (6 seat)','6 Bed frames','6 Wardrobes (3 door each)','1 Dining table + 12 chairs','12 Bedside tables','Coffee + 4 side tables','Free delivery & installation','Old furniture collected'] },
      '5 Kanal': { price:'85,00,000', items:['Drawing room: Premium suite sofa (11 seat)','TV lounge: Premium L-shape (7 seat)','7 Bed frames','7 Wardrobes (3 door each)','1 Dining table + 14 chairs','14 Bedside tables','Coffee + 6 side tables','Free delivery & installation','Old furniture collected'] }
