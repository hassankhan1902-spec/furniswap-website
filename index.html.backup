<script>
// ── Hamburger Menu ────────────────────────────────────────────
const navbar = document.getElementById('navbar');
function toggleMobileMenu() {
  const menu = document.getElementById('mobileMenu');
  const hamburger = document.getElementById('hamburger');
  const isOpen = menu.classList.contains('open');
  menu.classList.toggle('open', !isOpen);
  hamburger.classList.toggle('open', !isOpen);
  document.body.style.overflow = isOpen ? '' : 'hidden';
}

function closeMobileMenu() {
  document.getElementById('mobileMenu').classList.remove('open');
  document.getElementById('hamburger').classList.remove('open');
  document.body.style.overflow = '';
}

// Close menu on Escape
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMobileMenu(); });

// ── Scroll Progress + Back to Top ────────────────────────────
const progressBar = document.getElementById('scrollProgress');
const backToTop   = document.getElementById('backToTop');

window.addEventListener('scroll', () => {
  // Progress bar
  const scrolled = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
  progressBar.style.width = scrolled + '%';

  // Back to top visibility
  backToTop.classList.toggle('visible', window.scrollY > 500);

  // Nav scroll
  navbar.classList.toggle('scrolled', window.scrollY > 60);
}, { passive: true });

// ── Custom cursor (desktop only) ─────────────────────────────
const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
if (!isTouchDevice) {
const cursor = document.getElementById('cursor');
const follower = document.getElementById('follower');
let mouseX = 0, mouseY = 0, followerX = 0, followerY = 0;

document.addEventListener('mousemove', e => {
  mouseX = e.clientX; mouseY = e.clientY;
  cursor.style.left = mouseX + 'px';
  cursor.style.top = mouseY + 'px';
});

function animateFollower() {
  followerX += (mouseX - followerX) * 0.12;
  followerY += (mouseY - followerY) * 0.12;
  follower.style.left = followerX + 'px';
  follower.style.top = followerY + 'px';
  requestAnimationFrame(animateFollower);
}
animateFollower();
} // end desktop cursor

// ── Scroll reveal ─────────────────────────────────────────────
// On touch devices, make all animated elements immediately visible
if (isTouchDevice) {
  document.querySelectorAll('.how-step, .pkg-card, .faq-item, .how-visual, .cat-card').forEach(el => {
    el.classList.add('visible');
    el.style.opacity = '1';
    el.style.transform = 'none';
  });
} else {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('visible'), i * 100);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.how-step, .pkg-card, .faq-item, .how-visual').forEach(el => observer.observe(el));
}

// FAQ
function toggleFaq(question) {
  const item = question.parentElement;
  const isOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
  if (!isOpen) item.classList.add('open');
}

// ── Swap Value Calculator ──────────────────────────────────────
const calcPrices = {
  apartment: {
    economy:  { '1BR':380000,  '2BR':580000,  '3BR':780000  },
    standard: { '1BR':750000,  '2BR':1100000, '3BR':1450000 },
    premium:  { '1BR':1200000, '2BR':1800000, '3BR':2200000 }
  },
  house: {
    economy:  { '5 Marla':850000,  '10 Marla':1300000, '1 Kanal':1900000, '2 Kanal':2800000, '5 Kanal':4800000 },
    standard: { '5 Marla':1600000, '10 Marla':2400000, '1 Kanal':3500000, '2 Kanal':5000000, '5 Kanal':8500000 },
    premium:  { '5 Marla':2800000, '10 Marla':4200000, '1 Kanal':6200000, '2 Kanal':9000000, '5 Kanal':15000000 }
  }
};

const conditionRate = { good: 0.22, fair: 0.15, poor: 0.08 };
const aptSizesCalc   = ['1BR','2BR','3BR'];
const houseSizesCalc = ['5 Marla','10 Marla','1 Kanal','2 Kanal','5 Kanal'];

let calcState = { propType:'apartment', tier:'economy', size:'1BR', condition:'good' };

function calcSelectProp(type, btn) {
  calcState.propType = type;
  document.querySelectorAll('#calcPropBtns button').forEach(b => {
    b.style.background = 'transparent'; b.style.color = 'var(--muted)'; b.style.borderColor = 'var(--border)';
  });
  btn.style.background = 'var(--ink)'; btn.style.color = '#fff'; btn.style.borderColor = 'var(--ink)';

  document.getElementById('calcSizeLabel').textContent = type === 'apartment' ? 'Apartment Size' : 'House Size';
  const sizes = type === 'apartment' ? aptSizesCalc : houseSizesCalc;
  calcState.size = sizes[0];
  const sizeBtns = document.getElementById('calcSizeBtns');
  sizeBtns.style.gridTemplateColumns = type === 'house' ? 'repeat(auto-fit,minmax(72px,1fr))' : 'repeat(3,1fr)';
  sizeBtns.innerHTML = sizes.map((s,i) =>
    `<button onclick="calcSelect('size','${s}',this)" style="padding:10px 8px; border:1.5px solid ${i===0?'var(--terra)':'var(--border)'}; border-radius:3px; background:${i===0?'rgba(196,92,42,0.06)':'#fff'}; font-size:${type==='house'?'11px':'12px'}; font-weight:${i===0?'600':'500'}; color:${i===0?'var(--terra)':'var(--muted)'}; cursor:pointer; font-family:'DM Sans',sans-serif; min-height:44px;">${s}</button>`
  ).join('');
  updateCalc();
}

function calcSelect(type, value, btn) {
  calcState[type] = value;
  const groupId = type==='tier' ? 'calcTierBtns' : type==='size' ? 'calcSizeBtns' : 'calcCondBtns';
  document.querySelectorAll(`#${groupId} button`).forEach(b => {
    b.style.borderColor = 'var(--border)'; b.style.background = '#fff';
    b.style.color = 'var(--muted)'; b.style.fontWeight = '500';
  });
  btn.style.borderColor = 'var(--terra)'; btn.style.background = 'rgba(196,92,42,0.06)';
  btn.style.color = 'var(--terra)'; btn.style.fontWeight = '600';
  updateCalc();
}

function formatPKR(n) {
  if (n >= 10000000) return 'Rs. ' + (n/10000000).toFixed(1) + ' Cr';
  if (n >= 100000)   return 'Rs. ' + (n/100000).toFixed(1) + ' Lakh';
  return 'Rs. ' + n.toLocaleString('en-PK');
}

function updateCalc() {
  const prices = calcPrices[calcState.propType][calcState.tier];
  const pkg    = prices[calcState.size] || Object.values(prices)[0];
  const credit = Math.round(pkg * conditionRate[calcState.condition]);
  const pays   = pkg - credit;
  document.getElementById('resPackage').textContent = formatPKR(pkg);
  document.getElementById('resCredit').textContent  = '− ' + formatPKR(credit);
  document.getElementById('resFinal').textContent   = formatPKR(pays);
  const result = document.getElementById('calcResult');
  result.style.animation = 'none'; result.offsetHeight;
  result.style.animation = 'pricePop 0.3s ease';
}

// Init calculator size buttons on load
(function() {
  const sizeBtns = document.getElementById('calcSizeBtns');
  sizeBtns.innerHTML = aptSizesCalc.map((s,i) =>
    `<button onclick="calcSelect('size','${s}',this)" style="padding:10px 8px; border:1.5px solid ${i===0?'var(--terra)':'var(--border)'}; border-radius:3px; background:${i===0?'rgba(196,92,42,0.06)':'#fff'}; font-size:12px; font-weight:${i===0?'600':'500'}; color:${i===0?'var(--terra)':'var(--muted)'}; cursor:pointer; font-family:'DM Sans',sans-serif; min-height:44px;">${s}</button>`
  ).join('');
  updateCalc();
})();

// ── Modal ──────────────────────────────────────────────────────
function openModal() {
  const modal = document.getElementById('swapModal');
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  const modal = document.getElementById('swapModal');
  modal.style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('swapModal').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
function startSwap(beds) {
  const messages = {
    1: "Hi FurniSwap! 👋 I want to start my free furniture assessment. My apartment is a 1 Bedroom. Please guide me on the next steps.",
    2: "Hi FurniSwap! 👋 I want to start my free furniture assessment. My apartment is a 2 Bedroom. Please guide me on the next steps.",
    3: "Hi FurniSwap! 👋 I want to start my free furniture assessment. My apartment is a 3 Bedroom. Please guide me on the next steps."
  };
  const url = `https://wa.me/923437761250?text=${encodeURIComponent(messages[beds])}`;
  window.open(url, '_blank');
  closeModal();
}
document.querySelectorAll('.btn-primary, .pkg-btn, .btn-white, .faq-wa-btn').forEach(btn => {
  if (btn.href && btn.href.includes('wa.me')) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      openModal();
    });
  }
});

// Package pricing and furniture data
