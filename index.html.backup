      '3BR': { price:'14,50,000', items:['1 Premium L-shape sofa (7 seat)','3 Bed frames','3 Wardrobes (3 door each)','1 Dining table + 8 chairs','6 Bedside tables','1 Coffee + 2 side tables','Free delivery & installation','Old furniture collected'] }
    },
