      '3BR': { price:'7,80,000', items:['1 L-shape sofa (7 seat)','3 Bed frames','3 Wardrobes (2 door each)','1 Dining table + 8 chairs','Free delivery & installation','Old furniture collected'] }
    },
    standard: {
      '1BR': { price:'7,50,000', items:['1 Premium sofa set (3+2 seater — 5 seat)','1 Bed frame','1 Wardrobe (3 door)','1 Dining table + 4 chairs','2 Bedside tables','1 Coffee table','Free delivery & installation','Old furniture collected'] },
