      '2BR': { price:'18,00,000', items:['1 Designer sofa (3+2+1 seater — 6 seat)','1 King + 1 Queen beds','2 Walk-in wardrobe units','1 Dining table + 6 chairs','4 Designer bedside tables','Full décor & accessories','Free interior design','Priority delivery & installation','Old furniture collected'] },
      '3BR': { price:'22,00,000', items:['1 Designer L-shape sofa (7 seat)','1 King + 2 Queen beds','3 Walk-in wardrobe units','1 Dining table + 8 chairs','6 Designer bedside tables','Full décor & accessories','Free interior design','Priority delivery & installation','Old furniture collected'] }
