      '1 Kanal': { price:'62,00,000', items:['Drawing room: Designer L-shape sofa (7 seat)','TV lounge: Designer 3+2 seater (5 seat)','5 King/Queen beds','5 Walk-in wardrobe units','1 Designer dining table + 10 chairs','Full décor & accessories','Free interior design','Priority delivery & installation','Old furniture collected'] },
      '2 Kanal': { price:'90,00,000', items:['Drawing room: Designer L-shape sofa (9 seat)','TV lounge: Designer 3+2+1 seater (6 seat)','6 King/Queen beds','6 Walk-in wardrobe units','1 Designer dining table + 12 chairs','Full décor & accessories','Free interior design','Priority delivery & installation','Old furniture collected'] },
      '5 Kanal': { price:'1,50,00,000', items:['Drawing room: Bespoke sofa suite (11 seat)','TV lounge: Designer L-shape (7 seat)','7 King/Queen beds','7 Walk-in wardrobe units','1 Designer dining table + 14 chairs','Full décor & accessories','Free interior design','Dedicated installation team','Old furniture collected'] }
    }
  }
};

const checkClasses = { economy:'check-forest', standard:'check-terra', premium:'check-gold' };
const aptSizes   = ['1BR','2BR','3BR'];
const houseSizes = ['5 Marla','10 Marla','1 Kanal','2 Kanal','5 Kanal'];
let currentType  = 'apartment';

function renderItems(featuresEl, items, tier) {
  featuresEl.innerHTML = items.map(i => `<li><span class="feat-check ${checkClasses[tier]}">✓</span> ${i}</li>`).join('');
  featuresEl.style.animation = 'none';
  featuresEl.offsetHeight;
  featuresEl.style.animation = 'pricePop 0.3s ease';
}

function initCard(group) {
  const card      = group.closest('.pkg-card');
  const priceEl   = card.querySelector('.pkg-price');
  const featuresEl= card.querySelector('.pkg-features');
  const tierEl    = card.querySelector('.pkg-tier');
  let tier = 'economy';
  if (tierEl.classList.contains('tier-std')) tier = 'standard';
  if (tierEl.classList.contains('tier-prm')) tier = 'premium';

  const sizes = currentType === 'apartment' ? aptSizes : houseSizes;
  const defaultSize = sizes[0];

  // Rebuild buttons
  group.innerHTML = sizes.map((s,i) =>
    `<button class="pkg-size-btn${i===0?' active':''}" data-size="${s}">${s}</button>`
  ).join('');

  // Render default
  priceEl.textContent = 'Rs. ' + pkgData[currentType][tier][defaultSize].price;
  renderItems(featuresEl, pkgData[currentType][tier][defaultSize].items, tier);

  group.querySelectorAll('.pkg-size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      group.querySelectorAll('.pkg-size-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const size = btn.dataset.size;
      priceEl.textContent = 'Rs. ' + pkgData[currentType][tier][size].price;
      priceEl.style.animation = 'none'; priceEl.offsetHeight;
      priceEl.style.animation = 'pricePop 0.25s ease';
      renderItems(featuresEl, pkgData[currentType][tier][size].items, tier);
    });
  });
}

function switchType(type) {
  currentType = type;
  const aptBtn   = document.getElementById('tabApt');
  const houseBtn = document.getElementById('tabHouse');
  aptBtn.style.background   = type==='apartment' ? 'var(--ink)' : 'transparent';
  aptBtn.style.color        = type==='apartment' ? '#fff' : 'var(--muted)';
  houseBtn.style.background = type==='house' ? 'var(--ink)' : 'transparent';
  houseBtn.style.color      = type==='house' ? '#fff' : 'var(--muted)';
  document.querySelectorAll('.pkg-sizes').forEach(initCard);
}

// Initialise on load
document.querySelectorAll('.pkg-sizes').forEach(initCard);

const priceStyle = document.createElement('style');
priceStyle.textContent = '@keyframes pricePop { 0%{transform:scale(0.92);opacity:0.5} 100%{transform:scale(1);opacity:1} }';
document.head.appendChild(priceStyle);
</script>
</body>
</html>
